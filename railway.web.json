{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "app/**",
      "prisma/**",
      "scripts/**",
      "package.json",
      "Dockerfile",
      "shopify.app.toml",
      "railway.web.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/livez",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ALWAYS"
  }
}
