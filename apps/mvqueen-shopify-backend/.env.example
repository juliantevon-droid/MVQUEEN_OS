# Never commit real credentials.
MVQUEEN_ENV=development

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Safety defaults: reads are allowed; writes must remain blocked until explicitly enabled.
SHOPIFY_DRY_RUN=true
SHOPIFY_TIMEOUT_SECONDS=30
SHOPIFY_MAX_RETRIES=4
