{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": [
      "app/**",
      "prisma/**",
      "scripts/**",
      "package.json",
      "Dockerfile.worker",
      "shopify.app.toml",
      "railway.worker.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS"
  }
}
