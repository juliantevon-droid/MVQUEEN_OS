# MVQUEEN OMNILUXE — Environment Variables Template
# Copy this file to a local .env and fill in real credentials.
# DO NOT COMMIT THE .env FILE TO VERSION CONTROL.

# Shopify Configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=REPLACE_WITH_ENV_SECRET
SHOPIFY_API_VERSION=2026-07
SHOPIFY_DRY_RUN=true
SHOPIFY_TIMEOUT_SECONDS=30
SHOPIFY_MAX_RETRIES=4

# Engine Settings
DEBUG=False
LOG_LEVEL=info
