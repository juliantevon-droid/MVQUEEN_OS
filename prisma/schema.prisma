generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline             Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator         Boolean?  @default(false)
  emailVerified        Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires  DateTime?
}

model ProductAutomationState {
  id                      String   @id @default(cuid())
  shop                    String
  productGid              String
  sourceFingerprint       String?
  lastAutomationUpdatedAt DateTime?
  automationVersion       String   @default("mvq-catalog-v1")
  updatedAt               DateTime @updatedAt
  @@unique([shop, productGid])
}

model ProductJob {
  id              String   @id @default(cuid())
  shop            String
  productGid      String
  eventKey        String   @unique
  topic           String
  status           String   @default("received")
  attempts        Int      @default(0)
  error           String?
  receivedAt      DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  backfillRunId   String?
  @@index([shop, productGid])
  @@index([backfillRunId, status, receivedAt])
  @@index([status, receivedAt])
}


model ProductReleaseAudit {
  id                 String   @id @default(cuid())
  shop               String
  productGid         String
  contentFingerprint String
  actor              String
  decision           String
  operation          String
  result             String
  error              String?
  createdAt          DateTime @default(now())

  @@index([shop, contentFingerprint, operation, result])
  @@index([shop, productGid, createdAt])
  @@index([result, createdAt])
}


model CommercialSettings {
  id                           String   @id @default(cuid())
  shop                         String   @unique
  paymentRate                  Float?
  paymentFixed                 Float?
  returnReserveRate            Float?
  targetContributionMarginRate Float?
  targetCac                    Float?
  inboundShippingDefault       Float?
  currency                     String   @default("USD")
  updatedBy                    String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model CommercialSettingsAudit {
  id           String   @id @default(cuid())
  shop         String
  actor        String
  snapshotJson String
  createdAt    DateTime @default(now())

  @@index([shop, createdAt])
}


model ProductCommercialHealthState {
  id                                  String   @id @default(cuid())
  shop                                String
  productGid                          String
  sourceFingerprint                   String
  policyFingerprint                   String
  state                               String
  advertisingEligibility              String
  maxBreakEvenCac                     Float?
  maxCacAtTargetMargin                Float?
  breakEvenRoas                       Float?
  targetMarginRoasFloor               Float?
  targetRoas                          Float?
  contributionAfterTargetCac          Float?
  contributionMarginAfterTargetCac    Float?
  stale                               Boolean  @default(false)
  evaluatedAt                         DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  @@unique([shop, productGid])
  @@index([shop, state, stale])
}

model ProductCommercialHealthSnapshot {
  id                                  String   @id @default(cuid())
  shop                                String
  productGid                          String
  sourceFingerprint                   String
  policyFingerprint                   String
  state                               String
  advertisingEligibility              String
  maxBreakEvenCac                     Float?
  maxCacAtTargetMargin                Float?
  breakEvenRoas                       Float?
  targetMarginRoasFloor               Float?
  targetRoas                          Float?
  contributionAfterTargetCac          Float?
  contributionMarginAfterTargetCac    Float?
  createdAt                           DateTime @default(now())

  @@index([shop, productGid, createdAt])
  @@index([shop, state, createdAt])
}


model CatalogBackfillRun {
  id              String   @id @default(cuid())
  shop            String
  reason          String
  requestedBy     String
  writeMode       String   @default("dry_run")
  status          String   @default("scanning")
  scanCursor      String?
  scanComplete    Boolean  @default(false)
  totalProducts   Int      @default(0)
  enqueuedJobs    Int      @default(0)
  processedJobs   Int      @default(0)
  failedJobs      Int      @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop, status, createdAt])
  @@index([status, createdAt])
}


model RuntimeHeartbeat {
  id          String   @id @default(cuid())
  name        String   @unique
  state       String
  detailsJson String?
  updatedAt   DateTime @updatedAt

  @@index([state, updatedAt])
}
