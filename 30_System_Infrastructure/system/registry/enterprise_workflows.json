{
  "version": "2.0.0",
  "authority": "GitHub main",
  "workflows": [
    {
      "id": "product_intake",
      "status": "connected",
      "trigger": "Shopify products/create or products/update webhook",
      "authority": "Shopify",
      "steps": [
        "ingest",
        "fingerprint",
        "source_truth",
        "classify",
        "brand_route",
        "commercial_decision",
        "metadata_proposal"
      ],
      "writes": "approved metadata only",
      "failure_mode": "queue failed + visible control-plane error"
    },
    {
      "id": "catalog_health_audit",
      "status": "connected_read_only",
      "trigger": "operator opens Catalog Health",
      "authority": "Shopify",
      "steps": [
        "scan_catalog",
        "brand_integrity",
        "content_presence",
        "commercial_cost_presence",
        "pre_fee_margin_risk",
        "collection_integrity",
        "release_blocker_summary"
      ],
      "guard": "read-only; media ALT audit remains separate until Shopify Files permission is authorized"
    },
    {
      "id": "catalog_backfill_reprocessing",
      "status": "connected_manual_worker_ready",
      "trigger": "engine/policy change or operator-requested catalog re-evaluation",
      "authority": "MVQUEEN_OS durable queue + Shopify product truth",
      "steps": [
        "create_run_with_reason_and_write_mode",
        "cursor_scan_shopify_catalog_in_pages_of_100",
        "idempotently_enqueue_product_jobs",
        "process_bounded_batches",
        "evaluate_current_product_and_commercial_policy",
        "persist_health_state_and_history",
        "apply_safe_shopify_fields_only_when_all_write_gates_pass",
        "record_failed_jobs_without_stopping_remaining_batch",
        "complete_with_success_or_errors"
      ],
      "guard": "dry-run is default; governed-write additionally requires MVQ_WRITE_ENABLED=true and MVQ_BACKFILL_WRITE_ENABLED=true; unattended execution requires a protected worker token"
    },
    {
      "id": "canonical_content_release",
      "status": "connected_approval_required",
      "trigger": "QA-passed canonical record + matching release artifact",
      "authority": "PRODUCTION_READINESS -> authenticated Shopify app",
      "steps": [
        "generate_canonical_product_and_content_suite",
        "qa",
        "fingerprint_entire_approved_record",
        "human_approval",
        "stale_product_check",
        "publish_editorial_seo_and_whitelisted_product_metafields",
        "optional_content_surfaces_only_when_master_and_surface_gates_are_true",
        "audit"
      ],
      "protected": [
        "price",
        "compare_at_price",
        "sku",
        "inventory",
        "variants",
        "handle",
        "media_relationships"
      ],
      "guard": "Product editorial/metafields require canonical approval; blog, collection, FAQ-page and static-page surfaces additionally require MVQ_CONTENT_SURFACES_PUBLISH_ENABLED=true plus their exact per-surface gate. Legal policy pages are never automated."
    },
    {
      "id": "commercial_configuration",
      "status": "connected_audited",
      "trigger": "authenticated operator saves shop assumptions",
      "authority": "MVQUEEN_OS CommercialSettings",
      "steps": [
        "validate_rates_and_money",
        "persist_shop_settings",
        "append_audit_snapshot",
        "resolve_with_environment_fallback",
        "feed_pricing_and_product_decisions"
      ],
      "guard": "no missing assumption is invented; incomplete configuration keeps pricing blocked"
    },
    {
      "id": "commercial_health_evaluation",
      "status": "connected_policy_aware",
      "trigger": "product processing, live catalog audit, proposed price validation, or commercial-policy change",
      "authority": "MVQUEEN_OS commercial engine",
      "steps": [
        "resolve_current_shop_policy",
        "verify_cost_and_price",
        "calculate_payment_and_return_reserve",
        "calculate_contribution_before_ads",
        "calculate_max_break_even_cac",
        "calculate_contribution_after_target_cac",
        "calculate_break_even_and_target_roas",
        "classify_healthy_thin_or_blocked",
        "persist_current_state_and_history"
      ],
      "guard": "policy changes mark persisted product health stale; stale evidence is never advertising-eligible"
    },
    {
      "id": "pricing_profitability",
      "status": "connected_approval_required",
      "trigger": "verified unit cost + commercial configuration",
      "authority": "Shopify cost facts + app pricing engine",
      "steps": [
        "landed_cost",
        "fees_reserve",
        "target_cac",
        "contribution_floor",
        "recommendation",
        "human_approval",
        "single_variant_publish",
        "audit"
      ],
      "guard": "never publish below contribution floor; multi-variant requires variant-level costs"
    },
    {
      "id": "merchandising",
      "status": "connected_advisory_catalog_resolution",
      "trigger": "QA-passed canonical catalog + approved brand world",
      "authority": "PRODUCTION_READINESS catalog resolver + Shopify commerce truth",
      "steps": [
        "canonical_product_pipeline",
        "brand_world_partition",
        "taxonomy_similarity_scoring",
        "verified_fact_similarity",
        "related_product_resolution",
        "cross_sell_resolution",
        "relationship_audit",
        "human_review_before_live_relationship_write"
      ],
      "guard": "No cross-brand recommendations; no invented compatibility; no bundle creation without an approved bundle rule; no live relationship mutation from the offline resolver."
    },
    {
      "id": "catalog_release_gate",
      "status": "connected_decision_gate",
      "trigger": "catalog health evaluation",
      "authority": "Catalog Health + Commercial Health",
      "steps": [
        "brand_integrity",
        "seo_integrity",
        "content_presence",
        "verified_cost",
        "current_price",
        "commercial_health",
        "release_decision",
        "advertising_eligibility"
      ],
      "guard": "blockers prevent release eligibility; warnings require review; paid media additionally requires fresh advertising-eligible economics"
    },
    {
      "id": "storefront_release",
      "status": "connected_staging_first",
      "trigger": "GitHub main theme change",
      "authority": "GitHub main",
      "steps": [
        "theme_source",
        "staging_sync",
        "processing_check",
        "preview_qa",
        "explicit_live_release"
      ],
      "guard": "no automatic MAIN theme writes"
    },
    {
      "id": "paid_media",
      "status": "external_connection_required",
      "trigger": "approved campaign brief + commercial readiness",
      "authority": "external ad provider",
      "steps": [
        "brief",
        "creative",
        "account_selection",
        "budget_approval",
        "campaign_action",
        "performance_readback",
        "profitability_feedback"
      ],
      "guard": "no provider or human approval -> no spend/action; no fresh non-stale advertising-eligible product evidence -> no paid-media execution"
    },
    {
      "id": "analytics_learning",
      "status": "event_bus_connected_export_adapter_required",
      "trigger": "storefront commerce event",
      "authority": "first-party MVQueen event contract",
      "steps": [
        "emit",
        "consent_provider_adapter",
        "aggregate",
        "campaign_product_join",
        "profitability_analysis",
        "learning_proposal"
      ],
      "guard": "core event bus sends no third-party network requests"
    },
    {
      "id": "retention_lifecycle",
      "status": "plan_connected_execution_adapter_required",
      "trigger": "purchase/customer lifecycle signal",
      "authority": "approved lifecycle provider",
      "steps": [
        "post_purchase",
        "cross_sell",
        "replenishment_if_supported",
        "win_back",
        "performance_readback"
      ],
      "guard": "no fabricated urgency or unsupported replenishment timing"
    },
    {
      "id": "order_fulfillment",
      "status": "shopify_authority_manual_until_scoped",
      "trigger": "paid order",
      "authority": "Shopify",
      "steps": [
        "payment_confirmed",
        "fraud_risk_review",
        "supplier_fulfillment",
        "tracking",
        "delivery_exception",
        "return_refund_if_needed"
      ],
      "guard": "no automated order/customer writes until dedicated scopes and SOP tests are approved"
    },
    {
      "id": "customer_care",
      "status": "sop_ready_execution_human_governed",
      "trigger": "customer inquiry or exception",
      "authority": "support channel + Shopify order truth",
      "steps": [
        "identify_request",
        "verify_order_context",
        "policy_lookup",
        "resolution",
        "escalation",
        "feedback_loop"
      ],
      "guard": "privacy minimum necessary; policy facts only"
    },
    {
      "id": "finance",
      "status": "framework_ready_data_connection_required",
      "trigger": "daily/weekly close",
      "authority": "Shopify payouts + payment processor + ad spend + supplier costs",
      "steps": [
        "revenue",
        "refunds",
        "cogs",
        "fulfillment",
        "payment_fees",
        "ad_spend",
        "contribution_profit",
        "cash_reconciliation"
      ],
      "guard": "no profitability claim without complete source inputs"
    },
    {
      "id": "compliance",
      "status": "framework_ready_human_legal_values_required",
      "trigger": "policy/content/release change",
      "authority": "merchant-approved policies and applicable law",
      "steps": [
        "policy_source",
        "claim_review",
        "privacy_scope",
        "consent_requirements",
        "release_check"
      ],
      "guard": "no invented legal/business values"
    },
    {
      "id": "backup_recovery",
      "status": "multi_layer_ready_restore_test_required",
      "trigger": "release or incident",
      "authority": "GitHub history + Shopify theme backups + Drive archives",
      "steps": [
        "snapshot",
        "release",
        "monitor",
        "rollback_or_restore",
        "incident_record"
      ],
      "guard": "restore procedure must be tested before production sign-off"
    }
  ]
}
