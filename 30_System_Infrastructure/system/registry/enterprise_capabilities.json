  "non_negotiable_gates": {
    "money": "No live price mutation without verified cost inputs, configured fee assumptions, contribution-floor validation, MVQ_PRICE_PUBLISH_ENABLED=true, explicit product approval, and an authenticated human submission.",
    "advertising": "No ad spend, campaign creation, pausing, enabling, or budget changes without a connected approved provider and explicit action approval.",
    "product_truth": "No unsupported claims or invented product facts.",
    "protected_fields": [
      "sku",
      "inventory",
      "variant_identity",
      "handle",
      "source_media_relationships"
    ],
    "minors": "Paid audience targeting must follow platform and legal requirements; the operating system does not hard-code minor targeting."
  },
  "workflow_registry": "30_System_Infrastructure/system/registry/enterprise_workflows.json"
