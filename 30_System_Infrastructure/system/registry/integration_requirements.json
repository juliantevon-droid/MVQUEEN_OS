{
  "version": "1.0.0",
  "rule": "A capability may be marked connected only when required authority, permission, configuration, tests, audit path, and rollback/recovery behavior are present.",
  "integrations": [
    {
      "capability": "catalog_product_metadata",
      "provider": "Shopify Admin API",
      "state": "authorized_in_app_contract",
      "requirements": [
        "read_products",
        "write_products",
        "MVQ_WRITE_ENABLED",
        "MVQ_APPROVED_PRODUCT_GIDS"
      ],
      "side_effects": "approved classification, brand-routing, commercial-status, lifecycle-status and analytics metadata only"
    },
    {
      "capability": "canonical_editorial_seo_publish",
      "provider": "Shopify Admin API",
      "state": "engineered_not_runtime_verified",
      "requirements": [
        "read_products",
        "write_products",
        "MVQ_WRITE_ENABLED",
        "MVQ_EDITORIAL_PUBLISH_ENABLED",
        "MVQ_APPROVED_PRODUCT_GIDS",
        "QA-passed canonical release bundle",
        "matching content fingerprint",
        "fresh Shopify product state",
        "authenticated admin",
        "durable release audit"
      ],
      "side_effects": "title, description, product type, SEO and approved automation/release metafields"
    },
    {
      "capability": "approved_price_publish",
      "provider": "Shopify Admin API",
      "state": "engineered_not_runtime_verified",
      "requirements": [
        "read_products",
        "write_products",
        "MVQ_WRITE_ENABLED",
        "MVQ_PRICE_PUBLISH_ENABLED",
        "MVQ_APPROVED_PRODUCT_GIDS",
        "verified commercial.unit_cost",
        "commercial fee/reserve/CAC/margin configuration",
        "authenticated admin",
        "single variant until variant-level cost model exists",
        "durable price audit"
      ],
      "side_effects": "approved single-variant price only; compare-at price is untouched"
    },
    {
      "capability": "media_alt_publication",
      "provider": "Shopify Files",
      "state": "connected_runtime_verified",
      "requirements": [
        "MVQueen OS has read_files and write_files",
        "MVQ_MEDIA_ALT_SYNC_ENABLED=true for automatic repair",
        "only missing or low-quality ALT text is eligible",
        "file ALT writes are audited through the product worker"
      ],
      "side_effects": "file ALT text only; no source-media relationship changes"
    },
    {
      "capability": "theme_staging_sync",
      "provider": "Shopify Themes",
      "state": "connected",
      "requirements": [
        "read_themes",
        "write_themes",
        "unpublished target",
        "GitHub main source"
      ],
      "side_effects": "staging/unpublished theme files only"
    },
    {
      "capability": "theme_live_release",
      "provider": "Shopify Themes",
      "state": "owner_release_required",
      "requirements": [
        "final preview QA",
        "explicit merchant release decision"
      ],
      "side_effects": "publishes selected theme"
    },
    {
      "capability": "paid_advertising",
      "provider": "external paid-media adapter",
      "state": "external_connection_required",
      "requirements": [
        "provider connection",
        "account selection",
        "campaign identity mapping",
        "spend/conversion/revenue readback",
        "human approval for spend or campaign-state changes",
        "fresh non-stale product commercial evidence",
        "advertising_eligibility=eligible for every promoted product",
        "positive max_break_even_cac",
        "commercial policy fingerprint",
        "change-history audit",
        "positive max_cac_at_target_margin",
        "target_margin_roas_floor"
      ],
      "side_effects": "none until provider, execution flag, human approval, and fresh commercial eligibility evidence are present"
    },
    {
      "capability": "analytics_export",
      "provider": "external analytics adapter",
      "state": "external_connection_required",
      "requirements": [
        "provider connection",
        "consent/configuration review",
        "MVQueen event mapping",
        "attribution rules",
        "campaign/product identity joins"
      ],
      "side_effects": "measurement export/readback only by default"
    },
    {
      "capability": "lifecycle_retention",
      "provider": "external lifecycle provider",
      "state": "external_connection_required",
      "requirements": [
        "provider connection",
        "customer consent rules",
        "event mapping",
        "flow approval",
        "unsubscribe/suppression enforcement",
        "performance readback"
      ],
      "side_effects": "no outbound messaging until provider and execution gate are connected"
    },
    {
      "capability": "orders_fulfillment",
      "provider": "Shopify",
      "state": "scope_and_sop_required",
      "requirements": [
        "dedicated order/fulfillment scopes",
        "fraud/risk SOP",
        "supplier handoff contract",
        "tracking/exception workflow",
        "refund/return authorization",
        "audit"
      ],
      "side_effects": "no automated order/customer/fulfillment writes yet"
    },
    {
      "capability": "customer_care",
      "provider": "support channel plus Shopify order truth",
      "state": "human_governed",
      "requirements": [
        "minimum-necessary customer data",
        "approved policies",
        "escalation rules",
        "resolution audit"
      ],
      "side_effects": "human-controlled support actions"
    },
    {
      "capability": "finance_reconciliation",
      "provider": "Shopify payouts/payment processor/ad platforms/supplier costs",
      "state": "read_only_order_economics_connected_full_reconciliation_pending",
      "requirements": [
        "read_orders declared in Shopify app",
        "runtime confirmation that read_orders is granted",
        "read_products",
        "verified commercial.unit_cost snapshots",
        "Commercial Settings payment fee and fulfillment assumptions",
        "actual payment-processor fees for exact net payment cost",
        "actual ad spend for fully loaded contribution",
        "payout/cash reconciliation for accounting close",
        "tax treatment reviewed for accounting use"
      ],
      "side_effects": "read-only analysis; no order, refund, fulfillment, payout, or customer mutations"
    },
    {
      "capability": "compliance_release_gate",
      "provider": "merchant-approved policies and applicable law",
      "state": "human_legal_values_required",
      "requirements": [
        "policy source values",
        "claims review",
        "privacy/consent rules",
        "age-sensitive marketing safeguards",
        "release checklist"
      ],
      "side_effects": "blocks release when required values are missing"
    },
    {
      "capability": "production_database",
      "provider": "Railway managed PostgreSQL",
      "state": "connected_production_single_node_restore_drill_required",
      "requirements": [
        "Railway PostgreSQL service deployed",
        "MVQ_DATABASE_PROFILE=production",
        "PostgreSQL DATABASE_URL connected to web and worker",
        "persistent volume mounted",
        "production migrations applied by deployment path",
        "database restore drill still required",
        "monitoring remains active"
      ],
      "side_effects": "durable runtime state, sessions, jobs, commercial state and release audit"
    },
    {
      "capability": "backup_restore",
      "provider": "GitHub history, Shopify theme backups, Google Drive archives",
      "state": "restore_test_required",
      "requirements": [
        "documented restore order",
        "tested rollback",
        "incident owner",
        "post-restore verification"
      ],
      "side_effects": "restore only after incident/release approval"
    },
    {
      "capability": "commercial_cost_sync",
      "provider": "Shopify inventory",
      "state": "connected_runtime_verified",
      "requirements": [
        "MVQueen OS has read_inventory",
        "MVQ_COST_SYNC_ENABLED=true for worker synchronization",
        "Shopify inventoryItem.unitCost populated",
        "verified cost snapshot remains the only permitted cost persistence"
      ],
      "side_effects": "reads authoritative Shopify unit cost; persists verified commercial cost snapshot only through governed product processing"
    },
    {
      "capability": "commercial_health",
      "provider": "MVQUEEN_OS",
      "state": "connected_runtime_verified",
      "requirements": [
        "commercial settings configured",
        "verified product cost",
        "selling price",
        "current policy fingerprint",
        "ProductCommercialHealthState production table operational",
        "ProductCommercialHealthSnapshot production table operational",
        "worker evaluation remains current and non-stale"
      ],
      "side_effects": "internal current health state and append-only health history; approved Shopify commercial metadata through governed product processing"
    },
    {
      "capability": "catalog_backfill",
      "provider": "MVQUEEN_OS + Shopify Admin API",
      "state": "manual_connected_scheduler_optional",
      "requirements": [
        "managed runtime database for production durability",
        "read_products",
        "cursor-based scan",
        "bounded batch processing",
        "idempotent per-run product job keys",
        "MVQ_BACKFILL_WORKER_TOKEN with at least 32 characters for unattended execution",
        "external scheduler only if unattended execution is desired",
        "MVQ_WRITE_ENABLED=true and MVQ_BACKFILL_WRITE_ENABLED=true for catalog-wide writes"
      ],
      "side_effects": "dry-run evaluates and persists internal health state; governed-write uses the existing protected-field-safe product writer only when both write gates pass"
    }
  ]
}
