{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mvqueen://production/product-schema/1.0",
  "title": "MVQUEEN Canonical Product Production Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "source_truth", "protected_fields", "category", "pricing", "images", "intelligence", "copy", "seo", "merchandising", "commercial", "creative", "measurement", "qa", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "identity": {"type":"object","additionalProperties":false,"required":["product_id","source_name"],"properties":{"product_id":{"type":"string","minLength":1},"source_name":{"type":"string","minLength":1},"handle":{"type":"string"},"sku":{"type":"string"}}},
    "source_truth": {"type":"object","additionalProperties":false,"required":["facts"],"properties":{"facts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","value","source","verified"],"properties":{"name":{"type":"string","minLength":1},"value":{},"source":{"type":"string","minLength":1},"verified":{"type":"boolean"}}}}}},
    "protected_fields": {"type":"object","additionalProperties":false,"required":["fields"],"properties":{"fields":{"type":"array","items":{"type":"string"}}}},
    "category": {"type":"object","additionalProperties":false,"required":["product_type"],"properties":{"product_type":{"type":"string","minLength":1},"category":{"type":"string"},"subcategory":{"type":"string"}}},
    "pricing": {"type":"object","additionalProperties":false,"required":["source_price"],"properties":{"source_price":{"type":["number","string"]},"currency":{"type":"string"},"approved_publish_price":{"type":["number","string","null"]},"recommended_price":{"type":["number","string","null"]},"compare_at_price":{"type":["number","string","null"]}}},
    "images": {"type":"object","additionalProperties":false,"required":["items"],"properties":{"items":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["src"],"properties":{"src":{"type":"string","minLength":1},"alt":{"type":"string"},"verified":{"type":"boolean"}}}}}},
    "intelligence": {"type":"object","additionalProperties":false,"required":["customer_need","positioning"],"properties":{"customer_need":{"type":"string"},"desire":{"type":"string"},"use_context":{"type":"string"},"positioning":{"type":"string"},"supported_benefits":{"type":"array","items":{"type":"string"}},"differentiators":{"type":"array","items":{"type":"string"}},"objections":{"type":"array","items":{"type":"string"}},"collection_candidates":{"type":"array","items":{"type":"string"}},"cross_sell_candidates":{"type":"array","items":{"type":"string"}}}},
    "copy": {"type":"object","additionalProperties":false,"required":["title","short_description","description"],"properties":{"title":{"type":"string","minLength":1},"short_description":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"benefits":{"type":"array","items":{"type":"string"}},"features":{"type":"array","items":{"type":"string"}},"cta":{"type":"string"}}},
    "seo": {"type":"object","additionalProperties":false,"required":["seo_title","meta_description","primary_keyword","alt_texts"],"properties":{"seo_title":{"type":"string","minLength":1},"meta_description":{"type":"string","minLength":1,"maxLength":160},"handle_recommendation":{"type":"string"},"primary_keyword":{"type":"string","minLength":1},"secondary_keywords":{"type":"array","items":{"type":"string"}},"alt_texts":{"type":"array","items":{"type":"string"}}}},
    "merchandising": {"type":"object","additionalProperties":false,"properties":{"collections":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"related_products":{"type":"array","items":{"type":"string"}},"bundles":{"type":"array","items":{"type":"string"}}}},
    "commercial": {"type":"object","additionalProperties":false,"required":["angle","proof_available"],"properties":{"angle":{"type":"string"},"proof_available":{"type":"array","items":{"type":"string"}},"offer_eligibility":{"type":"array","items":{"type":"string"}},"price_guardrail":{"type":"string"},"trust_inputs":{"type":"array","items":{"type":"string"}},"objections_responses":{"type":"array","items":{"type":"string"}},"funnel_stage":{"type":"string"}}},
    "creative": {"type":"object","additionalProperties":false,"required":["assets"],"properties":{"assets":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["channel","asset_type","brief"],"properties":{"channel":{"type":"string"},"asset_type":{"type":"string"},"brief":{"type":"string"},"claim_constraints":{"type":"array","items":{"type":"string"}}}}}}},
    "measurement": {"type":"object","additionalProperties":false,"properties":{"events":{"type":"array","items":{"type":"string"}},"primary_kpi":{"type":"string"},"secondary_kpis":{"type":"array","items":{"type":"string"}}}},
    "qa": {"type":"object","additionalProperties":false,"required":["errors","warnings","passed"],"properties":{"errors":{"type":"array","items":{"type":"string"}},"warnings":{"type":"array","items":{"type":"string"}},"passed":{"type":"boolean"}}},
    "status": {"type":"string","enum":["RAW","NORMALIZED","INTELLIGENCE_READY","COPY_READY","SEO_READY","MERCH_READY","COMMERCIAL_READY","CREATIVE_READY","QA_PASSED","PRODUCTION_READY"]}
  }
}
