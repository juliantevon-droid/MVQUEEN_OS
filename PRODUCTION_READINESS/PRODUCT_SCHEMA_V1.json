{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mvqueen://production/product-schema/1.0",
  "title": "MVQueen Canonical Product Production Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "source_truth",
    "protected_fields",
    "category",
    "pricing",
    "images",
    "intelligence",
    "copy",
    "seo",
    "merchandising",
    "commercial",
    "creative",
    "measurement",
    "content_suite",
    "qa",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "source_name"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        }
      }
    },
    "source_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "source",
              "verified"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "source": {
                "type": "string",
                "minLength": 1
              },
              "verified": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "protected_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_type"
      ],
      "properties": {
        "product_type": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string"
        },
        "subcategory": {
          "type": "string"
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_price"
      ],
      "properties": {
        "source_price": {
          "type": [
            "number",
            "string"
          ]
        },
        "currency": {
          "type": "string"
        },
        "approved_publish_price": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "recommended_price": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "compare_at_price": {
          "type": [
            "number",
            "string",
            "null"
          ]
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "intelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_need",
        "positioning"
      ],
      "properties": {
        "customer_need": {
          "type": "string"
        },
        "desire": {
          "type": "string"
        },
        "use_context": {
          "type": "string"
        },
        "positioning": {
          "type": "string"
        },
        "supported_benefits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "differentiators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collection_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cross_sell_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brand_world": {
          "type": "string",
          "enum": [
            "mvqueen",
            "miss-princess",
            "needs-review"
          ]
        },
        "brand_name": {
          "type": "string"
        },
        "brand_tone": {
          "type": "string"
        },
        "brand_routing_reason": {
          "type": "string"
        },
        "brand_routing_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "review"
          ]
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "short_description",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "benefits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cta": {
          "type": "string"
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seo_title",
        "meta_description",
        "primary_keyword",
        "alt_texts"
      ],
      "properties": {
        "seo_title": {
          "type": "string",
          "minLength": 1
        },
        "meta_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "handle_recommendation": {
          "type": "string"
        },
        "primary_keyword": {
          "type": "string",
          "minLength": 1
        },
        "secondary_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alt_texts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "long_tail_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "internal_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "anchor",
              "target",
              "type",
              "reason"
            ],
            "properties": {
              "anchor": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "product",
                  "collection"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "catalog_relationship",
                  "explicit_collection_handle",
                  "verified_shopify_membership"
                ]
              }
            }
          }
        },
        "internal_link_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolver",
            "source_product_id",
            "brand_world",
            "product_links",
            "collection_links",
            "collection_urls_require_explicit_handle"
          ],
          "properties": {
            "resolver": {
              "type": "string",
              "const": "INTERNAL_LINKING_INTELLIGENCE_V1"
            },
            "source_product_id": {
              "type": "string",
              "minLength": 1
            },
            "brand_world": {
              "type": "string",
              "enum": [
                "mvqueen",
                "miss-princess"
              ]
            },
            "product_links": {
              "type": "number"
            },
            "collection_links": {
              "type": "number"
            },
            "collection_urls_require_explicit_handle": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    },
    "merchandising": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_products": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationship_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolver",
            "brand_world",
            "related",
            "cross_sell",
            "bundle_policy"
          ],
          "properties": {
            "resolver": {
              "type": "string",
              "const": "MERCHANDISING_INTELLIGENCE_V1"
            },
            "brand_world": {
              "type": "string",
              "enum": [
                "mvqueen",
                "miss-princess"
              ]
            },
            "related": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "product_id",
                  "score",
                  "reasons"
                ],
                "properties": {
                  "product_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "score": {
                    "type": "number"
                  },
                  "reasons": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "cross_sell": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "product_id",
                  "score",
                  "reasons"
                ],
                "properties": {
                  "product_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "score": {
                    "type": "number"
                  },
                  "reasons": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "bundle_policy": {
              "type": "string",
              "const": "no_approved_bundle_rule_no_bundle"
            }
          }
        }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle",
        "proof_available",
        "offer_eligibility",
        "price_guardrail",
        "trust_inputs",
        "objections_responses",
        "funnel_stage",
        "aov_strategy",
        "landing_page_requirements",
        "supported_differentiators",
        "profitability_authority",
        "advertising_guardrail"
      ],
      "properties": {
        "angle": {
          "type": "string"
        },
        "proof_available": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "offer_eligibility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "price_guardrail": {
          "type": "string"
        },
        "trust_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objections_responses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "funnel_stage": {
          "type": "string"
        },
        "aov_strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "related_products",
            "bundles"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "related_products": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "bundles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "landing_page_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supported_differentiators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profitability_authority": {
          "type": "string"
        },
        "advertising_guardrail": {
          "type": "string"
        }
      }
    },
    "creative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets"
      ],
      "properties": {
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "asset_type",
              "brief",
              "hook",
              "cta",
              "funnel_stage",
              "testing_variable",
              "claim_constraints"
            ],
            "properties": {
              "channel": {
                "type": "string"
              },
              "asset_type": {
                "type": "string"
              },
              "brief": {
                "type": "string"
              },
              "hook": {
                "type": "string"
              },
              "cta": {
                "type": "string"
              },
              "funnel_stage": {
                "type": "string"
              },
              "testing_variable": {
                "type": "string"
              },
              "claim_constraints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "primary_kpi",
        "secondary_kpis",
        "product_identifier",
        "tracking_key"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "primary_kpi": {
          "type": "string",
          "minLength": 1
        },
        "secondary_kpis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "product_identifier": {
          "type": "string",
          "minLength": 1
        },
        "tracking_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "warnings",
        "passed"
      ],
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "RAW",
        "NORMALIZED",
        "INTELLIGENCE_READY",
        "COPY_READY",
        "SEO_READY",
        "MERCH_READY",
        "COMMERCIAL_READY",
        "CREATIVE_READY",
        "QA_PASSED",
        "PRODUCTION_READY"
      ]
    },
    "content_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_version",
        "product_id",
        "product_page",
        "metafields",
        "collection",
        "blog",
        "site_faq",
        "governance",
        "qa"
      ],
      "properties": {
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "product_page": {
          "type": "object"
        },
        "metafields": {
          "type": "object"
        },
        "collection": {
          "type": "object"
        },
        "blog": {
          "type": "object"
        },
        "site_faq": {
          "type": "object"
        },
        "governance": {
          "type": "object"
        },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "errors",
            "passed",
            "status"
          ],
          "properties": {
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "passed": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "CONTENT_READY_FOR_REVIEW",
                "CONTENT_PUBLISH_ELIGIBLE",
                "CONTENT_BLOCKED"
              ]
            }
          }
        }
      }
    }
  }
}
