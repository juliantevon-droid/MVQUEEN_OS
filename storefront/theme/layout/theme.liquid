<!doctype html>
{% comment %} MVQUEEN live performance revalidation 2026-10-03 {% endcomment %}
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#FFFCF8">
    <link rel="icon" type="image/png" sizes="32x32" href="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-favicon-crown-32.png?v=1790334791">
    <link rel="apple-touch-icon" sizes="180x180" href="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-favicon-crown-180.png?v=1790334795">
    <link rel="icon" type="image/png" sizes="192x192" href="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-favicon-crown-192.png?v=1790334799">
    <meta name="msapplication-TileColor" content="#FFFCF8">
    {% if request.page_type == 'index' and collections['mvqueen-world'] != blank and collections['mvqueen-world'].products.first.featured_image != blank %}
      {% assign mvq_gateway_preload = collections['mvqueen-world'].products.first.featured_image %}
      <link
        rel="preload"
        as="image"
        href="{{ mvq_gateway_preload | image_url: width: 720 }}"
        imagesrcset="{{ mvq_gateway_preload | image_url: width: 320 }} 320w, {{ mvq_gateway_preload | image_url: width: 360 }} 360w, {{ mvq_gateway_preload | image_url: width: 412 }} 412w, {{ mvq_gateway_preload | image_url: width: 480 }} 480w, {{ mvq_gateway_preload | image_url: width: 540 }} 540w, {{ mvq_gateway_preload | image_url: width: 640 }} 640w, {{ mvq_gateway_preload | image_url: width: 720 }} 720w"
        imagesizes="(max-width: 749px) 100vw, 50vw"
        fetchpriority="high"
      >
    {% endif %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {% assign mvq_font_stylesheet = 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500;600;700&display=swap' %}
    <link href="{{ mvq_font_stylesheet }}" rel="stylesheet" media="print" fetchpriority="low" onload="this.media='all'">
    <noscript><link href="{{ mvq_font_stylesheet }}" rel="stylesheet"></noscript>
    {{ 'mvqueen.css' | asset_url | stylesheet_tag }}
    {% assign mvq_design_system_url = 'mvqueen-design-system.css' | asset_url %}
    {% assign mvq_header_css_url = 'mvqueen-header.css' | asset_url %}
    <link rel="preload" href="{{ mvq_design_system_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" href="{{ mvq_header_css_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
      {{ 'mvqueen-design-system.css' | asset_url | stylesheet_tag }}
      {{ 'mvqueen-header.css' | asset_url | stylesheet_tag }}
    </noscript>
    {% if request.page_type == 'product' %}
      {{ 'mvqueen-product.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if request.page_type == 'index' or page.handle == 'miss-princess' %}
      {{ 'brand-gateway.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% render 'seo-meta' %}
    {{ content_for_header }}
    {% if request.page_type == 'product' %}{% render 'product-schema' %}{% endif %}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }}}</script>
  </head>
  <body class="mvq-page mvq-page--{{ request.page_type }}">
    {% assign mvq_analytics_brand = 'MVQueen' %}
    {% if request.page_type == 'index' %}
      {% assign mvq_analytics_brand = 'MVQueen House' %}
    {% endif %}
    {% if product and product.tags contains 'mvq:brand:miss-princess' %}
      {% assign mvq_analytics_brand = 'Miss.Princess' %}
    {% elsif collection and collection.handle == 'miss-princess-world' %}
      {% assign mvq_analytics_brand = 'Miss.Princess' %}
    {% endif %}
    <script id="MVQAnalyticsContext" type="application/json">
      {
        "page_type": {{ request.page_type | json }},
        "path": {{ request.path | json }},
        "brand_world": {{ mvq_analytics_brand | json }},
        "product_id": {% if product %}{{ product.id | json }}{% else %}null{% endif %},
        "product_handle": {% if product %}{{ product.handle | json }}{% else %}null{% endif %},
        "product_title": {% if product %}{{ product.title | json }}{% else %}null{% endif %},
        "collection_handle": {% if collection %}{{ collection.handle | json }}{% else %}null{% endif %},
        "search_performed": {% if request.page_type == 'search' %}{{ search.performed | json }}{% else %}false{% endif %},
        "search_terms": {% if request.page_type == 'search' %}{{ search.terms | json }}{% else %}null{% endif %},
        "cart_item_count": {{ cart.item_count | json }}
      }
    </script>
    <a class="mvq-skip-link" href="#MainContent">Skip to content</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}
    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'footer' %}
    <script src="{{ 'mvqueen.js' | asset_url }}" defer></script>
    {% if request.page_type == 'collection' %}
      <script src="{{ 'mvqueen-ux.js' | asset_url }}" defer></script>
    {% endif %}
    <script src="{{ 'mvqueen-analytics.js' | asset_url }}" defer></script>
  </body>
</html>