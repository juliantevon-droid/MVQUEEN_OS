<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#FFF9F2">
    <link rel="icon" type="image/png" sizes="32x32" href="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-favicon-crown-32.png?v=1790334791">
    <link rel="apple-touch-icon" sizes="180x180" href="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-favicon-crown-180.png?v=1790334795">
    <link rel="icon" type="image/png" sizes="192x192" href="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-favicon-crown-192.png?v=1790334799">
    <meta name="msapplication-TileColor" content="#FFF9F2">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {{ 'mvqueen.css' | asset_url | stylesheet_tag }}
    {{ 'mvqueen-design-system.css' | asset_url | stylesheet_tag }}
    {{ 'mvqueen-header.css' | asset_url | stylesheet_tag }}
    {{ 'mvqueen-product.css' | asset_url | stylesheet_tag }}
    {{ 'brand-gateway.css' | asset_url | stylesheet_tag }}
    {% render 'seo-meta' %}
    {{ content_for_header }}
    {% if request.page_type == 'product' %}{% render 'product-schema' %}{% endif %}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }}}</script>
  </head>
  <body class="mvq-page mvq-page--{{ request.page_type }}">
    <a class="mvq-skip-link" href="#MainContent">Skip to content</a>
    {% section 'announcement-bar' %}
    {% unless request.page_type == 'index' %}{% section 'header' %}{% endunless %}
    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'footer' %}
    <script src="{{ 'mvqueen.js' | asset_url }}" defer></script>
    <script src="{{ 'mvqueen-ux.js' | asset_url }}" defer></script>
  </body>
</html>