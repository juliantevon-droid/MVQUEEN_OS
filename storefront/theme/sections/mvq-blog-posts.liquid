{% render 'mvq-section-kit' %}
{% if section.settings.blog != blank and section.settings.blog.articles_count > 0 %}
<div class="mvq-kit mvq-kit--{{ section.settings.palette }}" style="--kit-space: {{ section.settings.spacing }}px; --kit-columns: {{ section.settings.columns | default: 3 }}; --kit-ratio: {{ section.settings.ratio | default: 1 }};">
  <div class="mvq-kit__wrap">
    {% render 'mvq-section-heading', heading: section.settings.heading, intro: section.settings.intro %}
    <div class="mvq-kit__grid mvq-kit__grid--editorial">
      {% for article in section.settings.blog.articles limit: section.settings.limit %}
        <article class="mvq-kit__card">
          {% if article.image != blank %}<a href="{{ article.url }}" tabindex="-1" aria-hidden="true" class="mvq-kit__media">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,600,900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', alt: '' }}</a>{% endif %}
          {% if section.settings.show_date %}<time class="mvq-kit__meta" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'abbreviated_date' }}</time>{% endif %}
          <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
          {% if section.settings.show_excerpt %}<p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 | escape }}</p>{% endif %}
          <a href="{{ article.url }}" aria-label="{{ 'section_kit.controls.read_article' | t: title: article.title | escape }}">{{ 'section_kit.controls.read_more' | t }}</a>
        </article>
      {% endfor %}
    </div>
  </div>
</div>
{% elsif request.design_mode %}<div class="mvq-kit__wrap"><p class="mvq-kit__empty">{{ 'section_kit.empty.blog' | t }}</p></div>{% endif %}
{% schema %}
{
  "name": "MVQUEEN Blog posts",
  "tag": "section",
  "class": "mvq-editor-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ],
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the journal"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Posts to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image proportions",
      "options": [
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "1.5",
          "label": "Landscape"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Palette",
      "options": [
        {
          "value": "neutral",
          "label": "White"
        },
        {
          "value": "mvqueen",
          "label": "MVQUEEN ivory"
        },
        {
          "value": "princess",
          "label": "Miss.Princess blush"
        }
      ],
      "default": "neutral"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Section spacing",
      "min": 24,
      "max": 120,
      "step": 8,
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "MVQUEEN Blog posts"
    }
  ]
}
{% endschema %}
