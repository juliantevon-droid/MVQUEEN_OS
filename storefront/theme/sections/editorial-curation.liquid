<section class="mvq-editorial" aria-labelledby="mvq-editorial-title">
  <div class="mvq-container mvq-editorial__grid">
    <div class="mvq-editorial__intro">
      <div class="mvq-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 id="mvq-editorial-title" class="mvq-display">{{ section.settings.heading }}</h2>
      <p class="mvq-copy">{{ section.settings.copy }}</p>
      {% if section.settings.link_label != blank and section.settings.link_url != blank %}
        <a class="mvq-button mvq-button--quiet" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
    <div class="mvq-editorial__notes">
      {% for block in section.blocks %}
        <article class="mvq-editorial__note" {{ block.shopify_attributes }}>
          <span class="mvq-editorial__number">{{ forloop.index | prepend: '0' }}</span>
          <div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial curation",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE CURATOR'S NOTE"},
    {"type":"text","id":"heading","label":"Heading","default":"A considered edit, not a crowded catalog."},
    {"type":"textarea","id":"copy","label":"Copy","default":"Discover pieces selected for mood, versatility, and the feeling they create when they become yours."},
    {"type":"text","id":"link_label","label":"Link label","default":"Enter the edit"},
    {"type":"url","id":"link_url","label":"Link URL"}
  ],
  "blocks": [
    {
      "type":"note",
      "name":"Curation note",
      "settings":[
        {"type":"text","id":"title","label":"Title","default":"The statement piece"},
        {"type":"textarea","id":"text","label":"Text","default":"One intentional detail can change the entire look."}
      ]
    }
  ],
  "presets":[
    {
      "name":"Editorial curation",
      "blocks":[
        {"type":"note"},
        {"type":"note"},
        {"type":"note"}
      ]
    }
  ]
}
{% endschema %}
