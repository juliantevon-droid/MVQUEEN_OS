{% render 'mvq-section-kit' %}
{% if section.settings.before_image != blank and section.settings.after_image != blank %}
<div class="mvq-kit mvq-kit--{{ section.settings.palette }}" style="--kit-space: {{ section.settings.spacing }}px; --kit-columns: {{ section.settings.columns | default: 3 }}; --kit-ratio: {{ section.settings.ratio | default: 1 }};">
  <div class="mvq-kit__wrap">
    {% render 'mvq-section-heading', heading: section.settings.heading, intro: section.settings.intro %}
    <mvq-compare style="--kit-position: {{ section.settings.position }}%;">
      <div class="mvq-kit__compare-stage" data-compare-stage>
        {{ section.settings.after_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480,750,1100,1600', sizes: '(min-width: 1320px) 1280px, 100vw', class: 'mvq-kit__compare-after', draggable: 'false' }}
        {{ section.settings.before_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480,750,1100,1600', sizes: '(min-width: 1320px) 1280px, 100vw', class: 'mvq-kit__compare-before', draggable: 'false' }}
        <span class="mvq-kit__compare-line" aria-hidden="true"></span>
        <span class="mvq-kit__compare-label mvq-kit__compare-label--before">{{ section.settings.before_label | escape }}</span>
        <span class="mvq-kit__compare-label mvq-kit__compare-label--after">{{ section.settings.after_label | escape }}</span>
      </div>
      <div class="mvq-kit__range" data-compare-controls hidden>
        <label for="MVQCompare-{{ section.id }}">{{ 'section_kit.controls.compare' | t }}</label>
        <input id="MVQCompare-{{ section.id }}" type="range" min="0" max="100" step="1" value="{{ section.settings.position }}">
      </div>
    </mvq-compare>
  </div>
</div>
{% elsif request.design_mode %}<div class="mvq-kit__wrap"><p class="mvq-kit__empty">{{ 'section_kit.empty.comparison' | t }}</p></div>{% endif %}
{% schema %}
{
  "name": "MVQUEEN Before and after",
  "tag": "section",
  "class": "mvq-editor-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ],
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before and after"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "range",
      "id": "position",
      "label": "Initial comparison position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image proportions",
      "options": [
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "0.75",
          "label": "Portrait"
        },
        {
          "value": "1.3333",
          "label": "Landscape"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Palette",
      "options": [
        {
          "value": "neutral",
          "label": "White"
        },
        {
          "value": "mvqueen",
          "label": "MVQUEEN ivory"
        },
        {
          "value": "princess",
          "label": "Miss.Princess blush"
        }
      ],
      "default": "neutral"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Section spacing",
      "min": 24,
      "max": 120,
      "step": 8,
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "MVQUEEN Before and after"
    }
  ]
}
{% endschema %}
