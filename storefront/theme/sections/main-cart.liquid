<section class="mvq-cart">
  <div class="mvq-container">
    <header class="mvq-cart-head">
      <p class="mvq-eyebrow">YOUR BAG</p>
      <h1 class="mvq-display">Selected for you.</h1>
    </header>
    {% if cart.item_count == 0 %}
      <div class="mvq-cart-empty">
        <p>Your bag is waiting for something that feels like you.</p>
        <a class="mvq-button mvq-button--gold" href="{{ routes.all_products_collection_url }}">Explore the collection</a>
      </div>
    {% else %}
      {% form 'cart', cart %}
        <div class="mvq-cart-layout">
          <div class="mvq-cart-items">
            {% for item in cart.items %}
              <article class="mvq-cart-row">
                <a class="mvq-cart-image" href="{{ item.url }}" aria-label="View {{ item.product.title | escape }}">
                  {% if item.image %}{{ item.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180,300,420', sizes: '(max-width: 749px) 34vw, 180px', alt: item.image.alt | default: item.product.title | escape }}{% endif %}
                </a>
                <div class="mvq-cart-details">
                  <p class="mvq-cart-brand">
                    {% if item.product.tags contains 'mvq:brand:miss-princess' %}Miss.Princess{% else %}MVQueen{% endif %}
                    {% if item.product.type != blank %}<span aria-hidden="true">·</span> {{ item.product.type }}{% endif %}
                  </p>
                  <h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
                  {% unless item.product.has_only_default_variant %}<p class="mvq-cart-variant">{{ item.variant.title }}</p>{% endunless %}
                  <p class="mvq-cart-price">{{ item.final_line_price | money }}</p>
                  <label class="mvq-cart-qty">Quantity
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="Quantity for {{ item.product.title | escape }}">
                  </label>
                  <a class="mvq-cart-remove" href="{{ item.url_to_remove }}">Remove</a>
                </div>
              </article>
            {% endfor %}
          </div>
          <aside class="mvq-cart-summary">
            <div class="mvq-cart-summary-kicker">ONE BAG · TWO WORLDS</div>
            <p class="mvq-cart-summary-copy">Your MVQueen and Miss.Princess pieces stay together through one secure checkout.</p>
            <div class="mvq-cart-summary-line"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
            <div class="mvq-cart-delivery">
              <span class="mvq-cart-delivery__label">Estimated delivery</span>
              <strong>7–15 business days</strong>
              <p>Taxes and shipping charges are calculated at checkout.</p>
              <div class="mvq-cart-policy-links">
                <a href="/pages/shipping-policy">Shipping details</a>
                <a href="/pages/refund-policy">Refund & returns</a>
              </div>
            </div>
            <button class="mvq-button mvq-button--quiet" type="submit" name="update">Update bag</button>
            <button class="mvq-button mvq-button--gold" type="submit" name="checkout">Secure checkout</button>
            {% if additional_checkout_buttons %}
              <div class="mvq-cart-express" aria-label="Accelerated checkout options">
                <span class="mvq-cart-express__label">Or checkout faster</span>
                <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
              </div>
            {% endif %}
            <p class="mvq-cart-checkout-note">You’ll complete payment securely in Shopify checkout.</p>
            {% render 'trust-badges', preset: 'cart', compact: true %}
            <div class="mvq-cart-continue">
              <a href="/collections/mvqueen-world">Continue with MVQueen</a>
              <a href="/collections/miss-princess-world">Continue with Miss.Princess</a>
            </div>
          </aside>
        </div>
      {% endform %}
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"MVQueen Cart","settings":[],"presets":[{"name":"MVQueen Cart"}]}
{% endschema %}