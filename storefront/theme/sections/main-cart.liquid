<section class="mvq-container mvq-cart"><div class="mvq-eyebrow">YOUR BAG</div><h1>Selected for you.</h1>{% if cart.item_count == 0 %}<p>Your bag is waiting.</p><a class="mvq-btn" href="{{ routes.all_products_collection_url }}">Explore the collection</a>{% else %}{% form 'cart', cart %}{% for item in cart.items %}<div class="mvq-cart-row">{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title | escape }}<div><a href="{{ item.url }}">{{ item.product.title }}</a><div>{{ item.final_line_price | money }}</div><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title }}"></div><a href="{{ item.url_to_remove }}">Remove</a></div>{% endfor %}<div class="mvq-total"><p>Subtotal: <strong>{{ cart.total_price | money }}</strong></p><button class="mvq-btn" type="submit" name="update">Update bag</button><button class="mvq-btn" type="submit" name="checkout">Secure checkout</button></div>{% endform %}{% endif %}</section>{% schema %}{"name":"Main cart","settings":[]} {% endschema %}