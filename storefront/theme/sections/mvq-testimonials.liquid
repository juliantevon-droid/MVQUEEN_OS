{% render 'mvq-section-kit' %}
{% assign quote_count = 0 %}
{% capture quotes %}
  {% for block in section.blocks %}
    {% if block.settings.quote != blank %}
      {% assign quote_count = quote_count | plus: 1 %}
      <figure class="mvq-kit__quote" {{ block.shopify_attributes }}>
        {% if block.settings.rating > 0 %}<div class="mvq-kit__stars" role="img" aria-label="{{ 'section_kit.controls.rating' | t: rating: block.settings.rating | escape }}"><span aria-hidden="true">{% for star in (1..block.settings.rating) %}★{% endfor %}</span></div>{% endif %}
        <blockquote class="mvq-kit__richtext">{{ block.settings.quote }}</blockquote>
        {% if block.settings.name != blank %}<figcaption>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}{% endif %}<span>{{ block.settings.name | escape }}{% if block.settings.context != blank %}<br>{{ block.settings.context | escape }}{% endif %}</span></figcaption>{% endif %}
      </figure>
    {% elsif request.design_mode %}<p class="mvq-kit__empty" {{ block.shopify_attributes }}>{{ 'section_kit.empty.quote' | t }}</p>{% endif %}
  {% endfor %}
{% endcapture %}
{% if quote_count > 0 or request.design_mode %}
<div class="mvq-kit mvq-kit--{{ section.settings.palette }}" style="--kit-space: {{ section.settings.spacing }}px; --kit-columns: {{ section.settings.columns | default: 3 }}; --kit-ratio: {{ section.settings.ratio | default: 1 }};">
  <div class="mvq-kit__wrap">
    {% render 'mvq-section-heading', heading: section.settings.heading, intro: section.settings.intro %}
    <div class="mvq-kit__grid mvq-kit__grid--editorial">{{ quotes }}</div>
  </div>
</div>
{% endif %}
{% schema %}
{
  "name": "MVQUEEN Testimonials",
  "tag": "section",
  "class": "mvq-editor-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ],
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer stories"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "paragraph",
      "content": "Add genuine customer feedback and only use images and quotes you have permission to publish. No reviews are supplied by this section."
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Palette",
      "options": [
        {
          "value": "neutral",
          "label": "White"
        },
        {
          "value": "mvqueen",
          "label": "MVQUEEN ivory"
        },
        {
          "value": "princess",
          "label": "Miss.Princess blush"
        }
      ],
      "default": "neutral"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Section spacing",
      "min": 24,
      "max": 120,
      "step": 8,
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "MVQUEEN Testimonials",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote"
        },
        {
          "type": "quote"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Customer quote",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "context",
          "label": "Attribution or context"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating out of five (zero hides stars)",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 0
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
