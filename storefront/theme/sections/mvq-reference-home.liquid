    },
    {
      "type": "url",
      "id": "beauty_link",
      "label": "Beauty link"
    }
  ],
  "blocks": [
    {
      "type": "world",
      "name": "Brand world",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "copy",
          "label": "Copy"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Cta"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Image product"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination"
        }
      ]
    },
    {
      "type": "category",
      "name": "Category",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Image product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MVQueen Reference Home"
    }
  ]
}
{% endschema %}
