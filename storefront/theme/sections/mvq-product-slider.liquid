{% render 'mvq-section-kit' %}
{% liquid
  assign slider_products = section.settings.products
  if slider_products == blank
    assign slider_products = section.settings.collection.products
  endif
  assign track_id = 'MVQProducts-' | append: section.id
%}
{% if slider_products.size > 0 %}
<div class="mvq-kit mvq-kit--{{ section.settings.palette }}" style="--kit-space: {{ section.settings.spacing }}px; --kit-columns: {{ section.settings.columns | default: 3 }}; --kit-ratio: {{ section.settings.ratio | default: 1 }};">
  <div class="mvq-kit__wrap">
    {% render 'mvq-section-heading', heading: section.settings.heading, intro: section.settings.intro %}
    <mvq-carousel data-autoplay="false" aria-label="{{ section.settings.heading | default: section.settings.accessibility_label | escape }}" role="region">
      <ul id="{{ track_id }}" class="mvq-kit__track" data-track tabindex="0">
        {% for item in slider_products limit: section.settings.limit %}<li data-slide>{% render 'product-card', product: item %}</li>{% endfor %}
      </ul>
      {% render 'mvq-carousel-controls', track_id: track_id %}
    </mvq-carousel>
  </div>
</div>
{% elsif request.design_mode %}<div class="mvq-kit__wrap"><p class="mvq-kit__empty">{{ 'section_kit.empty.products' | t }}</p></div>{% endif %}
{% schema %}
{
  "name": "MVQUEEN Product slider",
  "tag": "section",
  "class": "mvq-editor-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ],
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the edit"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Slider accessibility label",
      "default": "Featured products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Selected products",
      "limit": 16
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection when no products are selected"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Palette",
      "options": [
        {
          "value": "neutral",
          "label": "White"
        },
        {
          "value": "mvqueen",
          "label": "MVQUEEN ivory"
        },
        {
          "value": "princess",
          "label": "Miss.Princess blush"
        }
      ],
      "default": "neutral"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Section spacing",
      "min": 24,
      "max": 120,
      "step": 8,
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "MVQUEEN Product slider"
    }
  ]
}
{% endschema %}
