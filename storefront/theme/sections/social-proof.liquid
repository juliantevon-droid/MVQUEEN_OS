{% if section.settings.enabled %}
<section class="mvq-section mvq-social-proof">
  <div class="mvq-container">
    <p class="mvq-eyebrow">FROM THE MVQUEEN COMMUNITY</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="mvq-proof-grid">
      {% if section.settings.reviews_text != blank %}
        <div><strong>Customer reviews</strong><p>{{ section.settings.reviews_text }}</p></div>
      {% endif %}
      {% if section.settings.community_text != blank %}
        <div><strong>Community style</strong><p>{{ section.settings.community_text }}</p></div>
      {% endif %}
      {% if section.settings.press_text != blank %}
        <div><strong>Press & features</strong><p>{{ section.settings.press_text }}</p></div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "MVQUEEN Social Proof",
  "settings": [
    {"type":"checkbox","id":"enabled","label":"Show verified social proof","default":false},
    {"type":"text","id":"heading","label":"Heading","default":"Chosen for real life."},
    {"type":"textarea","id":"reviews_text","label":"Verified review summary"},
    {"type":"textarea","id":"community_text","label":"Approved community content summary"},
    {"type":"textarea","id":"press_text","label":"Verified press summary"}
  ],
  "presets": [{"name":"MVQUEEN Social Proof"}]
}
{% endschema %}