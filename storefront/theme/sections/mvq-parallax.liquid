{% render 'mvq-section-kit' %}
{% liquid
  assign eager = true
  if section.index > 1
    assign eager = false
  endif
  assign has_main_panel = false
  if section.settings.image != blank or section.settings.mobile_image != blank or section.settings.heading != blank or section.settings.content != blank
    assign has_main_panel = true
  elsif section.settings.button_label != blank and section.settings.button_link != blank
    assign has_main_panel = true
  elsif request.design_mode and section.blocks.size == 0
    assign has_main_panel = true
  endif
%}
{% capture panels %}
  {% if has_main_panel %}
    {% render 'mvq-parallax-panel', panel_settings: section.settings, section_settings: section.settings, eager: eager %}
    {% assign eager = false %}
  {% endif %}
  {% for block in section.blocks %}
    {% liquid
      assign has_block_content = false
      if block.settings.image != blank or block.settings.mobile_image != blank or block.settings.heading != blank or block.settings.content != blank
        assign has_block_content = true
      elsif block.settings.button_label != blank and block.settings.button_link != blank
        assign has_block_content = true
      endif
    %}
    {% if has_block_content or request.design_mode %}
      {% render 'mvq-parallax-panel', panel_settings: block.settings, section_settings: section.settings, block_attributes: block.shopify_attributes, eager: eager %}
      {% assign eager = false %}
    {% endif %}
  {% endfor %}
{% endcapture %}
{% assign panels = panels | strip %}
{% if panels != blank %}
<div class="mvq-kit mvq-kit--{{ section.settings.palette }}" style="--kit-space: {{ section.settings.spacing }}px; --kit-panel-gap: {{ section.settings.panel_gap | default: 24 }}px; --kit-height: {{ section.settings.height }}px; --kit-mobile-height: {{ section.settings.mobile_height }}px; --kit-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  <div class="mvq-kit__wrap mvq-kit__parallax-stack">
    {{ panels }}
  </div>
</div>
{% endif %}
{% schema %}
{
  "name": "MVQUEEN Parallax",
  "tag": "section",
  "class": "mvq-editor-section",
  "max_blocks": 8,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ],
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Add Image blocks for multiple panels. Each block has desktop and mobile images. The optional main panel below appears first when it has content."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Main mobile image",
      "info": "Optional. Uses the desktop image when empty. A mobile image on its own also works."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "panel_gap",
      "label": "Space between image panels",
      "min": 0,
      "max": 64,
      "step": 8,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 320,
      "max": 760,
      "step": 40,
      "default": 560
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 320,
      "max": 600,
      "step": 40,
      "default": 440
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Dark overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 60
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "strength",
      "label": "Parallax movement",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "mobile_parallax",
      "label": "Enable motion on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Palette",
      "options": [
        {
          "value": "neutral",
          "label": "White"
        },
        {
          "value": "mvqueen",
          "label": "MVQUEEN ivory"
        },
        {
          "value": "princess",
          "label": "Miss.Princess blush"
        }
      ],
      "default": "neutral"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Section spacing",
      "min": 24,
      "max": 120,
      "step": 8,
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Uses the desktop image when empty. A mobile image on its own also works."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MVQUEEN Parallax",
      "blocks": [
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
