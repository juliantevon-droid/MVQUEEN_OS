<section class="mvq-sister-experience" aria-labelledby="miss-princess-title">
  <div class="mvq-container">
    <div class="mvq-sister-shell">
      <p class="mvq-eyebrow">A SISTER BRAND</p>
      <h1 id="miss-princess-title">Miss.Princess</h1>
      <p class="mvq-sister-lede">A distinct sister brand with a softer, more playful point of view — intentionally separate from the MVQueen edit while sharing the same creative foundation.</p>
      {% if section.settings.menu != blank %}
        <nav class="mvq-sister-nav" aria-label="Miss.Princess navigation">
          {% for link in section.settings.menu.links %}
            <div class="mvq-sister-nav-group">
              {% if link.links != blank %}
                <details>
                  <summary>{{ link.title }}</summary>
                  <div class="mvq-sister-nav-links">
                    {% for child_link in link.links %}
                      <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                      {% if child_link.links != blank %}
                        <div class="mvq-sister-nav-grandchildren">
                          {% for grandchild_link in child_link.links %}
                            <a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                          {% endfor %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </details>
              {% else %}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {% endif %}
            </div>
          {% endfor %}
        </nav>
      {% endif %}
      <div class="mvq-sister-grid">
        <a class="mvq-sister-card" href="/pages/miss-princess"><span>Enter the experience</span><strong>Miss.Princess edit</strong></a>
        <a class="mvq-sister-card" href="/pages/miss-princess"><span>Explore the sister brand</span><strong>Miss.Princess world</strong></a>
        <a class="mvq-sister-card" href="/pages/contact"><span>Need help?</span><strong>Contact us</strong></a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Miss.Princess Sister Experience","settings":[{"type":"link_list","id":"menu","label":"Miss.Princess menu","default":"miss-princess-menu"}],"presets":[{"name":"Miss.Princess Sister Experience"}]}
{% endschema %}