<section class="mvq-section mvq-house-story" aria-labelledby="HouseStory-{{ section.id }}">
  <div class="mvq-container mvq-house-story__grid">
    <div>
      <p class="mvq-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="HouseStory-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <div class="mvq-copy">
      <p>{{ section.settings.copy }}</p>
      <div class="mvq-house-story__worlds">
        <a href="/collections/mvqueen-world">
          <strong>MVQueen</strong>
          <span>Neutral · Bold · Refined</span>
        </a>
        <a href="/pages/miss-princess">
          <strong>Miss.Princess</strong>
          <span>Soft · Bright · Playful</span>
        </a>
      </div>
      <a class="mvq-button mvq-button--quiet" href="{{ section.settings.link_url | default: '/pages/about' }}">{{ section.settings.link_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "House story",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"ONE HOUSE · TWO WORLDS"},
    {"type":"text","id":"heading","label":"Heading","default":"Made for every version of you."},
    {"type":"textarea","id":"copy","label":"Copy","default":"MVQueen and Miss.Princess share one storefront, one bag, and one standard of thoughtful curation — with two distinct moods so you can shop the version of yourself you want to express today."},
    {"type":"text","id":"link_label","label":"Link label","default":"About us"},
    {"type":"url","id":"link_url","label":"Link URL"}
  ],
  "presets": [{"name":"House story"}]
}
{% endschema %}
