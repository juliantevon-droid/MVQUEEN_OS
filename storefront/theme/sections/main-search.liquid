<section class="mvq-container mvq-search">
  <div class="mvq-eyebrow">SEARCH MVQUEEN</div>
  <h1>Find your next favorite.</h1>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <label class="mvq-visually-hidden" for="SearchInput">Search MVQueen</label>
    <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search fashion, beauty, jewelry..." autocomplete="off">
    <input type="hidden" name="type" value="product">
    <button class="mvq-btn" type="submit">Search</button>
  </form>
  {% if search.performed %}
    <p>{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}</p>
    {% if search.results_count > 0 %}
      <div class="mvq-grid" style="text-align:left;margin-top:45px">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', product: item %}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p>No products matched that search. Try a broader term.</p>
    {% endif %}
  {% endif %}
</section>
{% schema %}
{"name":"Main search","settings":[]}
{% endschema %}