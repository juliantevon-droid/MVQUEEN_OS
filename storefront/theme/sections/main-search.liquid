<section class="mvq-container mvq-search"><div class="mvq-eyebrow">SEARCH MVQUEEN</div><h1>Find your next favorite.</h1><form action="{{ routes.search_url }}"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search fashion, beauty, jewelry..." aria-label="Search"><button class="mvq-btn" type="submit">Search</button></form>{% if search.performed %}<div class="mvq-grid" style="text-align:left;margin-top:45px">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Main search","settings":[]} {% endschema %}