{% render 'mvq-section-kit' %}
{% assign track_id = 'MVQSlides-' | append: section.id %}
{% if section.blocks.size > 0 %}
<div class="mvq-kit mvq-kit--{{ section.settings.palette }}" style="--kit-space: {{ section.settings.spacing }}px; --kit-height: {{ section.settings.height }}px; --kit-mobile-height: {{ section.settings.mobile_height }}px; --kit-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  <div class="mvq-kit__wrap">
    {% render 'mvq-section-heading', heading: section.settings.heading %}
    <mvq-carousel data-loop="true" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval }}" role="region" aria-label="{{ section.settings.heading | default: section.settings.accessibility_label | escape }}" aria-roledescription="{{ 'section_kit.controls.carousel' | t | escape }}">
      <div id="{{ track_id }}" class="mvq-kit__track mvq-kit__slides" data-track tabindex="0">
        {% for block in section.blocks %}
          {% liquid
            assign eager = false
            if forloop.first
              unless section.index > 1
                assign eager = true
              endunless
            endif
          %}
          <div class="mvq-kit__slide" data-slide role="group" aria-roledescription="{{ 'section_kit.controls.slide' | t | escape }}" aria-label="{{ 'section_kit.controls.position' | t: current: forloop.index, total: forloop.length | escape }}" {{ block.shopify_attributes }}>
            <div class="mvq-kit__backdrop">{% render 'mvq-section-image', image: block.settings.image, mobile_image: block.settings.mobile_image, eager: eager %}</div>
            <span class="mvq-kit__shade" aria-hidden="true"></span>
            <div class="mvq-kit__caption mvq-kit__caption--{{ section.settings.alignment }}">
              {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
              <div class="mvq-kit__richtext">{{ block.settings.content }}</div>
              {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="mvq-kit__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
              {% if request.design_mode and block.settings.image == blank and block.settings.heading == blank %}<p>{{ 'section_kit.empty.slide' | t }}</p>{% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      {% render 'mvq-carousel-controls', track_id: track_id, autoplay: section.settings.autoplay %}
    </mvq-carousel>
  </div>
</div>
{% endif %}
{% schema %}
{
  "name": "MVQUEEN Slideshow",
  "tag": "section",
  "class": "mvq-editor-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ],
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Slideshow accessibility label",
      "default": "Featured stories"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Automatically advance slides",
      "default": false
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds between slides",
      "min": 5,
      "max": 15,
      "step": 1,
      "default": 7
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 320,
      "max": 760,
      "step": 40,
      "default": 560
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 320,
      "max": 600,
      "step": 40,
      "default": 440
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Dark overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 60
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Palette",
      "options": [
        {
          "value": "neutral",
          "label": "White"
        },
        {
          "value": "mvqueen",
          "label": "MVQUEEN ivory"
        },
        {
          "value": "princess",
          "label": "Miss.Princess blush"
        }
      ],
      "default": "neutral"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Section spacing",
      "min": 24,
      "max": 120,
      "step": 8,
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "MVQUEEN Slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
