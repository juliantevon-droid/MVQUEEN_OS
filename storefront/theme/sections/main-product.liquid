{% assign is_jewelry_product = false %}
{% if product.tags contains 'mvq:category:jewelry' %}{% assign is_jewelry_product = true %}{% endif %}
<section class="mvq-product-page{% if is_jewelry_product %} mvq-product-page--jewelry{% endif %}">
  <div class="mvq-container">
    {% render 'breadcrumbs' %}
    <div class="mvq-product-layout">
      <div class="mvq-product-media" aria-label="{{ product.title | escape }} product images">
        {% for media in product.media %}
          {% if media.preview_image %}
            <div class="mvq-product-media-item">
              {% if forloop.first %}
                {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1400', sizes: '(max-width: 800px) 100vw, 58vw', alt: media.alt | default: product.title | escape }}
              {% else %}
                {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(max-width: 800px) 100vw, 58vw', alt: media.alt | default: product.title | escape }}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="mvq-product-info">
        {% liquid
          assign catalog_short = product.metafields.catalog.short_description.value
          assign automation_short = product.metafields.automation.short_description.value
          assign custom_short = product.metafields.custom.short_description.value
          assign short_description = catalog_short | default: automation_short | default: custom_short

          assign catalog_highlights = product.metafields.catalog.highlights.value
          assign automation_highlights = product.metafields.automation.highlights.value
          assign custom_highlights = product.metafields.custom.highlights.value
          assign highlights = catalog_highlights | default: automation_highlights | default: custom_highlights

          assign material = product.metafields.attributes.material.value | default: product.metafields.custom.material.value
          assign color = product.metafields.attributes.color.value | default: product.metafields.custom.stone_color.value
          assign occasion = product.metafields.attributes.occasion.value
          assign main_stone = product.metafields.attributes.main_stone.value | default: product.metafields.custom.main_stone.value
          assign stone_size = product.metafields.attributes.main_stone_size.value | default: product.metafields.custom.stone_size.value
          assign pendant_length = product.metafields.attributes.size_length.value | default: product.metafields.custom.pendant_length.value
          assign total_weight = product.metafields.attributes.total_weight.value | default: product.metafields.custom.total_weight.value

          assign canonical_ingredients = product.metafields.attributes.ingredients
          assign canonical_ingredient = product.metafields.attributes.ingredient
          assign canonical_key_ingredient = product.metafields.attributes.key_ingredient
          assign canonical_how_to_use = product.metafields.content.how_to_use
          assign canonical_care = product.metafields.content.care_instructions
          assign canonical_faq = product.metafields.content.faq.value

          assign product_form_id = 'ProductForm-' | append: section.id
        %}

        {% if product.type != blank %}<p class="mvq-eyebrow">{{ product.type }}</p>{% endif %}
        <h1 class="mvq-display">{{ product.title }}</h1>
        <div class="mvq-product-price">{{ product.selected_or_first_available_variant.price | money }}</div>

        {% if short_description != blank %}
          <div class="mvq-product-intro">{{ short_description }}</div>
        {% endif %}

        {% if highlights != blank %}
          <div class="mvq-product-highlights" aria-label="Product highlights">
            <ul class="mvq-product-bullets">
              {% for highlight in highlights %}
                <li>{{ highlight }}</li>
              {% endfor %}
            </ul>
          </div>
        {% elsif material != blank or color != blank or occasion != blank or main_stone != blank or stone_size != blank %}
          <div class="mvq-product-highlights" aria-label="Key product details">
            <ul class="mvq-product-bullets">
              {% if main_stone != blank %}<li><strong>Stone:</strong> {{ main_stone }}</li>{% endif %}
              {% if material != blank %}<li><strong>Material:</strong> {{ material }}</li>{% endif %}
              {% if color != blank %}<li><strong>Color:</strong> {{ color }}</li>{% endif %}
              {% if stone_size != blank %}<li><strong>Size:</strong> {{ stone_size }}</li>{% endif %}
              {% if occasion != blank %}<li><strong>Occasion:</strong> {{ occasion }}</li>{% endif %}
            </ul>
          </div>
        {% endif %}

        {% form 'product', product, id: product_form_id, class: 'mvq-product-form' %}
          {% unless product.has_only_default_variant %}
            <div class="mvq-product-option">
              <label for="ProductVariant-{{ section.id }}">Choose an option</label>
              <select id="ProductVariant-{{ section.id }}" name="id">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>
                {% endfor %}
              </select>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endunless %}
          <div class="mvq-product-quantity">
            <label for="Quantity-{{ section.id }}">Quantity</label>
            <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
          </div>
          <button class="mvq-button mvq-button--gold" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>
        {% endform %}

        <div class="mvq-product-accordions">
          {% if product.description != blank %}
            <details>
              <summary>Product details</summary>
              <div class="mvq-product-description">{{ product.description }}</div>
            </details>
          {% endif %}

          {% if pendant_length != blank or total_weight != blank %}
            <details>
              <summary>Measurements</summary>
              <ul class="mvq-product-bullets mvq-product-bullets--compact">
                {% if pendant_length != blank %}<li><strong>Pendant length:</strong> {{ pendant_length }}</li>{% endif %}
                {% if total_weight != blank %}<li><strong>Total weight:</strong> {{ total_weight }}</li>{% endif %}
              </ul>
            </details>
          {% endif %}

          {% if canonical_ingredients != blank %}
            <details><summary>Ingredients</summary>{{ canonical_ingredients | metafield_tag }}</details>
          {% elsif canonical_ingredient != blank %}
            <details><summary>Ingredient</summary>{{ canonical_ingredient | metafield_tag }}</details>
          {% elsif canonical_key_ingredient != blank %}
            <details><summary>Key ingredient</summary>{{ canonical_key_ingredient | metafield_tag }}</details>
          {% elsif product.metafields.custom.ingredients != blank %}
            <details><summary>Ingredients</summary>{{ product.metafields.custom.ingredients | metafield_tag }}</details>
          {% endif %}

          {% if canonical_how_to_use != blank %}
            <details><summary>How to use</summary>{{ canonical_how_to_use | metafield_tag }}</details>
          {% elsif product.metafields.custom.how_to_use != blank %}
            <details><summary>How to use</summary>{{ product.metafields.custom.how_to_use | metafield_tag }}</details>
          {% endif %}

          {% if canonical_care != blank %}
            <details><summary>Care</summary>{{ canonical_care | metafield_tag }}</details>
          {% elsif product.metafields.custom.care_instructions != blank %}
            <details><summary>Care</summary>{{ product.metafields.custom.care_instructions | metafield_tag }}</details>
          {% endif %}
          {% if product.metafields.custom.size_guide != blank %}
            <details><summary>Size guide</summary>{{ product.metafields.custom.size_guide | metafield_tag }}</details>
          {% endif %}

          <details>
            <summary>Shipping & returns</summary>
            {% if product.metafields.custom.shipping_note != blank %}
              <div class="mvq-product-shipping-note">{{ product.metafields.custom.shipping_note | metafield_tag }}</div>
            {% endif %}
            <p class="mvq-product-policy-links">
              <a href="/pages/shipping-policy">Shipping policy</a>
              <span aria-hidden="true">·</span>
              <a href="/pages/refund-policy">Refund & returns</a>
            </p>
          </details>

          {% if canonical_faq != blank %}
            <div class="mvq-product-faqs" aria-label="Frequently asked questions">
              {% for faq_item in canonical_faq %}
                {% if faq_item.question != blank and faq_item.answer != blank %}
                  <details class="mvq-product-faq-item">
                    <summary>{{ faq_item.question }}</summary>
                    <p>{{ faq_item.answer }}</p>
                  </details>
                {% endif %}
              {% endfor %}
            </div>
          {% elsif product.metafields.custom.faq != blank %}
            <details><summary>Frequently asked questions</summary>{{ product.metafields.custom.faq | metafield_tag }}</details>
          {% endif %}
        </div>

        {% render 'trust-badges' %}
        <p class="mvq-trust-note">Secure checkout · Clear product details · Customer care when you need it</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name":"MVQueen Product","settings":[],"presets":[{"name":"MVQueen Product"}]}
{% endschema %}
