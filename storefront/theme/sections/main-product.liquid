<section class="mvq-product-page"><div class="mvq-container">{% render 'breadcrumbs' %}<div class="mvq-product-layout"><div class="mvq-product-media">{% for media in product.media %}{% if media.preview_image %}<div class="mvq-product-media-item"><img src="{{ media.preview_image | image_url: width: 1400 }}" alt="{{ media.alt | default: product.title | escape }}" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}></div>{% endif %}{% endfor %}</div><div class="mvq-product-info">{% if product.type != blank %}<p class="mvq-eyebrow">{{ product.type }}</p>{% endif %}<h1>{{ product.title }}</h1><div class="mvq-product-price">{{ product.selected_or_first_available_variant.price | money }}</div>{% if product.metafields.custom.short_description != blank %}<div class="mvq-product-intro">{{ product.metafields.custom.short_description | metafield_tag }}</div>{% endif %}<div class="mvq-product-description">{{ product.description }}</div><form method="post" action="{{ routes.cart_add_url }}" id="ProductForm-{{ section.id }}">{% unless product.has_only_default_variant %}<label for="ProductVariant-{{ section.id }}">Choose an option</label><select id="ProductVariant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1"><button class="mvq-button mvq-button--primary" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button></form><div class="mvq-product-accordions">{% if product.metafields.custom.highlights != blank %}<details open><summary>Highlights</summary>{{ product.metafields.custom.highlights | metafield_tag }}</details>{% endif %}{% if product.metafields.custom.ingredients != blank %}<details><summary>Ingredients</summary>{{ product.metafields.custom.ingredients | metafield_tag }}</details>{% endif %}{% if product.metafields.custom.how_to_use != blank %}<details><summary>How to use</summary>{{ product.metafields.custom.how_to_use | metafield_tag }}</details>{% endif %}{% if product.metafields.custom.care_instructions != blank %}<details><summary>Care</summary>{{ product.metafields.custom.care_instructions | metafield_tag }}</details>{% endif %}{% if product.metafields.custom.size_guide != blank %}<details><summary>Size guide</summary>{{ product.metafields.custom.size_guide | metafield_tag }}</details>{% endif %}{% if product.metafields.custom.shipping_note != blank %}<details><summary>Shipping</summary>{{ product.metafields.custom.shipping_note | metafield_tag }}</details>{% endif %}{% if product.metafields.custom.faq != blank %}<details><summary>Frequently asked questions</summary>{{ product.metafields.custom.faq | metafield_tag }}</details>{% endif %}</div><p class="mvq-trust-note">Secure checkout · Clear product details · Customer care when you need it</p></div></div></div></section>{% schema %}{"name":"MVQUEEN Product","settings":[],"presets":[{"name":"MVQUEEN Product"}]}{% endschema %}