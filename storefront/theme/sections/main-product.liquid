<section class="mvq-product-page">
  <div class="mvq-container">
    {% render 'breadcrumbs' %}
    <div class="mvq-product-layout">
      <div class="mvq-product-media" aria-label="{{ product.title | escape }} product images">
        {% for media in product.media %}
          {% if media.preview_image %}
            <div class="mvq-product-media-item">
              {{ media.preview_image | image_url: width: 1400 | image_tag: loading: forloop.first | default: false, fetchpriority: forloop.first | default: 'auto', widths: '600,900,1200,1400', sizes: '(max-width: 800px) 100vw, 58vw', alt: media.alt | default: product.title | escape }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="mvq-product-info">
        {% if product.type != blank %}<p class="mvq-eyebrow">{{ product.type }}</p>{% endif %}
        <h1 class="mvq-display">{{ product.title }}</h1>
        <div class="mvq-product-price">{{ product.selected_or_first_available_variant.price | money }}</div>
        {% if product.metafields.custom.short_description != blank %}<div class="mvq-product-intro">{{ product.metafields.custom.short_description | metafield_tag }}</div>{% endif %}
        {% if product.description != blank %}<div class="mvq-product-description">{{ product.description }}</div>{% endif %}

        {% form 'product', product, id: 'ProductForm-' | append: section.id, class: 'mvq-product-form' %}
          {% unless product.has_only_default_variant %}
            <div class="mvq-product-option">
              <label for="ProductVariant-{{ section.id }}">Choose an option</label>
              <select id="ProductVariant-{{ section.id }}" name="id">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>
                {% endfor %}
              </select>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endunless %}
          <div class="mvq-product-quantity">
            <label for="Quantity-{{ section.id }}">Quantity</label>
            <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
          </div>
          <button class="mvq-button mvq-button--gold" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>
        {% endform %}

        <div class="mvq-product-accordions">
          {% if product.metafields.custom.highlights != blank %}<details open><summary>Highlights</summary>{{ product.metafields.custom.highlights | metafield_tag }}</details>{% endif %}
          {% if product.metafields.custom.ingredients != blank %}<details><summary>Ingredients</summary>{{ product.metafields.custom.ingredients | metafield_tag }}</details>{% endif %}
          {% if product.metafields.custom.how_to_use != blank %}<details><summary>How to use</summary>{{ product.metafields.custom.how_to_use | metafield_tag }}</details>{% endif %}
          {% if product.metafields.custom.care_instructions != blank %}<details><summary>Care</summary>{{ product.metafields.custom.care_instructions | metafield_tag }}</details>{% endif %}
          {% if product.metafields.custom.size_guide != blank %}<details><summary>Size guide</summary>{{ product.metafields.custom.size_guide | metafield_tag }}</details>{% endif %}
          {% if product.metafields.custom.shipping_note != blank %}<details><summary>Shipping</summary>{{ product.metafields.custom.shipping_note | metafield_tag }}</details>{% endif %}
          {% if product.metafields.custom.faq != blank %}<details><summary>Frequently asked questions</summary>{{ product.metafields.custom.faq | metafield_tag }}</details>{% endif %}
        </div>
        {% render 'trust-badges' %}
        <p class="mvq-trust-note">Secure checkout · Clear product details · Customer care when you need it</p>
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"MVQUEEN Product","settings":[],"presets":[{"name":"MVQUEEN Product"}]}
{% endschema %}