{% assign is_mvqueen_experience = false %}
{% assign is_princess_experience = false %}
{% assign is_house_home = false %}
{% if request.page_type == 'index' %}
  {% assign is_house_home = true %}
{% endif %}
{% if request.path contains '/pages/mvqueen' %}
  {% assign is_mvqueen_experience = true %}
{% endif %}
{% if request.path contains '/pages/miss-princess' %}
  {% assign is_princess_experience = true %}
{% endif %}

{% if collection %}
  {% if collection.handle contains 'miss-princess' %}
    {% assign is_princess_experience = true %}
    {% assign is_mvqueen_experience = false %}
  {% elsif collection.handle contains 'mvqueen' %}
    {% assign is_mvqueen_experience = true %}
    {% assign is_princess_experience = false %}
  {% endif %}
{% endif %}

{% if product %}
  {% if product.tags contains 'mvq:brand:miss-princess' %}
    {% assign is_princess_experience = true %}
    {% assign is_mvqueen_experience = false %}
  {% elsif product.tags contains 'mvq:brand:mvqueen' %}
    {% assign is_mvqueen_experience = true %}
    {% assign is_princess_experience = false %}
  {% endif %}
{% endif %}

{% assign active_menu = section.settings.menu %}
{% assign mvqueen_full_menu = linklists['mvqueen-full-menu'] %}
{% assign princess_full_menu = linklists['miss-princess-full-menu'] %}
{% comment %}
  Read tags from the unfiltered global collection drops. Shopify can return an
  empty all_tags array while tags is populated; do not fall back to the current
  page's collection.tags, which changes when a shopper applies filters.
{% endcomment %}
{% assign mvqueen_menu_tags = collections['mvqueen-world'].all_tags | default: collections['mvqueen-world'].tags %}
{% assign princess_menu_tags = collections['miss-princess-world'].all_tags | default: collections['miss-princess-world'].tags %}
{% if is_princess_experience and princess_full_menu.links != blank %}
  {% assign active_menu = princess_full_menu %}
{% elsif is_mvqueen_experience and mvqueen_full_menu.links != blank %}
  {% assign active_menu = mvqueen_full_menu %}
{% endif %}

{% assign mvq_header_logo_width = settings.brand_logo_width | default: 148 | at_most: 196 %}
{% assign mvq_mobile_logo_width = mvq_header_logo_width | at_most: 146 %}
{% capture mvq_header_logo_sizes %}(max-width: 749px) {{ mvq_mobile_logo_width }}px, {{ mvq_header_logo_width }}px{% endcapture %}
<header class="mvq-header{% if is_princess_experience %} mvq-header--princess{% elsif is_mvqueen_experience %} mvq-header--mvqueen{% endif %}">
  <div class="mvq-container mvq-nav">
    <button class="mvq-menu" type="button" data-mvq-menu aria-label="Open menu" aria-controls="MVQMobilePanel" aria-expanded="false">
      <span aria-hidden="true">☰</span>
    </button>

    {% liquid
      assign brand_home_url = routes.root_url
      if is_princess_experience
        assign brand_home_url = '/pages/miss-princess'
      elsif is_mvqueen_experience
        assign brand_home_url = '/pages/mvqueen'
      endif
    %}
    <a class="mvq-logo" href="{{ brand_home_url }}" aria-label="{% if is_princess_experience %}Miss.Princess home{% elsif is_mvqueen_experience %}MVQueen home{% else %}MVQueen brand gateway{% endif %}" style="--mvq-logo-width: {{ settings.brand_logo_width | default: 148 }}px">
      {% if is_princess_experience %}
        <span class="mvq-logo-wordmark mvq-logo-wordmark--princess">Miss.Princess</span>
      {% elsif settings.brand_logo != blank %}
        {{ settings.brand_logo | image_url: width: 196 | image_tag: class: 'mvq-logo-image', widths: '132,146,180,196', sizes: mvq_header_logo_sizes, loading: 'eager', fetchpriority: 'low', decoding: 'async', alt: 'MVQueen — Most Valuable Queen' }}
      {% else %}
        <img class="mvq-logo-image" src="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=180" srcset="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=132 132w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=146 146w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=180 180w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=196 196w" sizes="{{ mvq_header_logo_sizes }}" width="180" height="81" alt="MVQueen — Most Valuable Queen" loading="eager" fetchpriority="low" decoding="async">
      {% endif %}
    </a>

    <nav class="mvq-navlinks" aria-label="{% if is_house_home %}MVQueen house{% elsif is_princess_experience %}Miss.Princess{% else %}MVQueen{% endif %} navigation">
      {% if is_house_home and mvqueen_full_menu.links != blank and princess_full_menu.links != blank %}
        {% assign house_shop_links = mvqueen_full_menu.links | slice: 0, 1 %}
        {% assign house_princess_shop_links = princess_full_menu.links | slice: 0, 1 %}
        {% assign house_utility_links = section.settings.menu.links | slice: 2, 50 %}
        {% render 'mvq-header-menu', links: house_shop_links, mvqueen_tags: mvqueen_menu_tags, princess_tags: princess_menu_tags %}
        {% render 'mvq-header-menu', links: house_princess_shop_links, mvqueen_tags: mvqueen_menu_tags, princess_tags: princess_menu_tags %}
        {% render 'mvq-header-menu', links: house_utility_links, mvqueen_tags: mvqueen_menu_tags, princess_tags: princess_menu_tags %}
      {% else %}
        {% render 'mvq-header-menu', links: active_menu.links, mvqueen_tags: mvqueen_menu_tags, princess_tags: princess_menu_tags %}
      {% endif %}
    </nav>

    <div class="mvq-actions" aria-label="Store actions">
      <a href="{{ routes.search_url }}" aria-label="Search store"><span class="mvq-action-label">Search</span><span class="mvq-action-icon" aria-hidden="true">⌕</span></a>
      <a href="{{ routes.cart_url }}" aria-label="Shopping bag, {{ cart.item_count }} items"><span class="mvq-action-label">Bag</span><span class="mvq-bag-count">{{ cart.item_count }}</span></a>
    </div>
  </div>

  <nav id="MVQMobilePanel" class="mvq-mobile-panel" data-mvq-panel hidden inert aria-label="{% if is_princess_experience %}Miss.Princess{% elsif is_mvqueen_experience %}MVQueen{% else %}MVQueen house{% endif %} mobile mega menu">
    <div class="mvq-mobile-mega-inner">
      <div class="mvq-mobile-mega-head">
        <span class="mvq-mobile-mega-eyebrow">{% if is_princess_experience %}MISS.PRINCESS MENU{% elsif is_mvqueen_experience %}MVQUEEN MENU{% else %}SHOP THE HOUSE{% endif %}</span>
        <strong>{% if is_princess_experience %}Soft · Bright · Playful{% elsif is_mvqueen_experience %}Neutral · Bold · Refined{% else %}One house · Two distinct worlds{% endif %}</strong>
      </div>

      <div class="mvq-mobile-brand-hubs" aria-label="Brand worlds">
        <a class="mvq-mobile-brand-hub{% if is_mvqueen_experience %} is-active{% endif %}" href="/pages/mvqueen">
          <span>MVQueen</span>
          <small>Neutral · Bold · Refined</small>
        </a>
        <a class="mvq-mobile-brand-hub mvq-mobile-brand-hub--princess{% if is_princess_experience %} is-active{% endif %}" href="/pages/miss-princess">
          <span>Miss.Princess</span>
          <small>Soft · Bright · Playful</small>
        </a>
      </div>

      <div class="mvq-mobile-mega-nav">
        {% if is_house_home and mvqueen_full_menu.links != blank and princess_full_menu.links != blank %}
          {% render 'mvq-header-menu', links: house_shop_links, mobile: true, mvqueen_tags: mvqueen_menu_tags, princess_tags: princess_menu_tags %}
          {% render 'mvq-header-menu', links: house_princess_shop_links, mobile: true, mvqueen_tags: mvqueen_menu_tags, princess_tags: princess_menu_tags %}
          {% render 'mvq-header-menu', links: house_utility_links, mobile: true, mvqueen_tags: mvqueen_menu_tags, princess_tags: princess_menu_tags %}
        {% else %}
          {% render 'mvq-header-menu', links: active_menu.links, mobile: true, mvqueen_tags: mvqueen_menu_tags, princess_tags: princess_menu_tags %}
        {% endif %}
      </div>

      <div class="mvq-mobile-mega-utility" aria-label="Store shortcuts">
        <a href="{{ routes.search_url }}">Search</a>
        <a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a>
        <a href="/pages/contact">Contact</a>
      </div>
    </div>
  </nav>
</header>

{% if settings.show_brand_switcher != false %}
  <div class="mvq-brand-switcher{% if is_princess_experience %} mvq-brand-switcher--princess{% endif %}" aria-label="Choose a brand experience">
    <div class="mvq-container mvq-brand-switcher-inner">
      <a class="mvq-brand-choice{% if is_mvqueen_experience %} is-active{% endif %}" href="/pages/mvqueen"{% if is_mvqueen_experience %} aria-current="page"{% endif %}>
        <span class="mvq-brand-choice-name">MVQueen</span>
        <span class="mvq-brand-choice-note">Neutral · Bold · Refined</span>
      </a>
      <span class="mvq-brand-divider" aria-hidden="true"></span>
      <a class="mvq-brand-choice{% if is_princess_experience %} is-active{% endif %}" href="/pages/miss-princess"{% if is_princess_experience %} aria-current="page"{% endif %}>
        <span class="mvq-brand-choice-name">Miss.Princess</span>
        <span class="mvq-brand-choice-note">Soft · Bright · Playful</span>
      </a>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "MVQueen menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
