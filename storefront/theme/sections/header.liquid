<header class="mvq-header"><div class="mvq-container mvq-nav"><button class="mvq-menu" type="button" data-mvq-menu aria-label="Open menu" aria-controls="MVQMobilePanel" aria-expanded="false">☰</button><a class="mvq-logo" href="{{ routes.root_url }}" aria-label="MVQUEEN home">MVQUEEN</a><nav class="mvq-navlinks" aria-label="Primary navigation">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav><div class="mvq-actions" aria-label="Store actions"><a href="{{ routes.search_url }}" aria-label="Search MVQUEEN">Search</a><a href="{{ routes.cart_url }}" aria-label="Shopping bag, {{ cart.item_count }} items">Bag <span class="mvq-bag-count">{{ cart.item_count }}</span></a></div></div><nav id="MVQMobilePanel" class="mvq-mobile-panel mvq-container" data-mvq-panel hidden aria-label="Mobile navigation">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav></header>{% schema %}{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}{% endschema %}