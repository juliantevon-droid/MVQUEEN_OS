{% assign is_mvqueen_experience = false %}
{% assign is_princess_experience = false %}

{% if request.page_type == 'index' %}
  {% assign is_mvqueen_experience = true %}
{% endif %}

{% if request.path contains '/pages/mvqueen' %}
  {% assign is_mvqueen_experience = true %}
{% endif %}
{% if request.path contains '/pages/miss-princess' %}
  {% assign is_princess_experience = true %}
{% endif %}

{% if collection %}
  {% if collection.handle contains 'miss-princess' %}
    {% assign is_princess_experience = true %}
    {% assign is_mvqueen_experience = false %}
  {% elsif collection.handle contains 'mvqueen' %}
    {% assign is_mvqueen_experience = true %}
    {% assign is_princess_experience = false %}
  {% endif %}
{% endif %}

{% if product %}
  {% if product.tags contains 'mvq:brand:miss-princess' %}
    {% assign is_princess_experience = true %}
    {% assign is_mvqueen_experience = false %}
  {% elsif product.tags contains 'mvq:brand:mvqueen' %}
    {% assign is_mvqueen_experience = true %}
    {% assign is_princess_experience = false %}
  {% endif %}
{% endif %}

{% assign active_menu = section.settings.menu %}
{% if is_princess_experience and linklists['miss-princess-menu'].links != blank %}
  {% assign active_menu = linklists['miss-princess-menu'] %}
{% endif %}

<header class="mvq-header{% if is_princess_experience %} mvq-header--princess{% elsif is_mvqueen_experience %} mvq-header--mvqueen{% endif %}">
  <div class="mvq-container mvq-nav">
    <button class="mvq-menu" type="button" data-mvq-menu aria-label="Open menu" aria-controls="MVQMobilePanel" aria-expanded="false">
      <span aria-hidden="true">☰</span>
    </button>

    {% liquid
      assign brand_home_url = routes.root_url
      if is_princess_experience
        assign brand_home_url = '/pages/miss-princess'
      elsif is_mvqueen_experience
        assign brand_home_url = routes.root_url
      endif
    %}
    <a class="mvq-logo" href="{{ brand_home_url }}" aria-label="{% if is_princess_experience %}Miss.Princess home{% elsif is_mvqueen_experience %}MVQueen home{% else %}MVQueen brand gateway{% endif %}" style="--mvq-logo-width: {{ settings.brand_logo_width | default: 148 }}px">
      {% if is_princess_experience %}
        <span class="mvq-logo-wordmark mvq-logo-wordmark--princess">Miss.Princess</span>
      {% elsif settings.brand_logo != blank %}
        {{ settings.brand_logo | image_url: width: 440 | image_tag: class: 'mvq-logo-image', widths: '220,320,440', sizes: '(max-width: 749px) 132px, 148px', loading: 'eager', alt: 'MVQueen — Most Valuable Queen' }}
      {% else %}
        <img class="mvq-logo-image" src="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639" width="956" height="431" alt="MVQueen — Most Valuable Queen" loading="eager">
      {% endif %}
    </a>

    <nav class="mvq-navlinks" aria-label="{% if is_princess_experience %}Miss.Princess{% else %}MVQueen{% endif %} navigation">
      {% for link in active_menu.links %}
        {% if link.links != blank %}
          <details class="mvq-nav-item">
            <summary>{{ link.title }}</summary>
            <div class="mvq-nav-dropdown" role="group" aria-label="{{ link.title }}">
              {% for child_link in link.links %}
                <div class="mvq-mega-column">
                  <a class="mvq-mega-heading" href="{{ child_link.url }}">{{ child_link.title }}</a>
                  {% if child_link.links != blank %}
                    <div class="mvq-nav-subgroup">
                      {% for grandchild_link in child_link.links %}
                        <a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </details>
        {% else %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="mvq-actions" aria-label="Store actions">
      <a href="{{ routes.search_url }}" aria-label="Search store"><span class="mvq-action-label">Search</span><span class="mvq-action-icon" aria-hidden="true">⌕</span></a>
      <a href="{{ routes.cart_url }}" aria-label="Shopping bag, {{ cart.item_count }} items"><span class="mvq-action-label">Bag</span><span class="mvq-bag-count">{{ cart.item_count }}</span></a>
    </div>
  </div>

  <nav id="MVQMobilePanel" class="mvq-mobile-panel mvq-container" data-mvq-panel hidden inert aria-label="{% if is_princess_experience %}Miss.Princess{% else %}MVQueen{% endif %} mobile navigation">
    {% for link in active_menu.links %}
      {% if link.links != blank %}
        <details class="mvq-mobile-group">
          <summary>{{ link.title }}</summary>
          <div class="mvq-mobile-submenu">
            {% for child_link in link.links %}
              <a href="{{ child_link.url }}">{{ child_link.title }}</a>
              {% if child_link.links != blank %}
                {% for grandchild_link in child_link.links %}
                  <a class="mvq-mobile-grandchild" href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
        </details>
      {% else %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endif %}
    {% endfor %}
  </nav>
</header>

{% if settings.show_brand_switcher != false %}
  <div class="mvq-brand-switcher{% if is_princess_experience %} mvq-brand-switcher--princess{% endif %}" aria-label="Choose a brand experience">
    <div class="mvq-container mvq-brand-switcher-inner">
      <a class="mvq-brand-choice{% if is_mvqueen_experience %} is-active{% endif %}" href="{{ routes.root_url }}"{% if is_mvqueen_experience %} aria-current="page"{% endif %}>
        <span class="mvq-brand-choice-name">MVQueen</span>
        <span class="mvq-brand-choice-note">Neutral · Bold · Refined</span>
      </a>
      <span class="mvq-brand-divider" aria-hidden="true"></span>
      <a class="mvq-brand-choice{% if is_princess_experience %} is-active{% endif %}" href="/pages/miss-princess"{% if is_princess_experience %} aria-current="page"{% endif %}>
        <span class="mvq-brand-choice-name">Miss.Princess</span>
        <span class="mvq-brand-choice-note">Soft · Bright · Playful</span>
      </a>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "MVQueen menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}