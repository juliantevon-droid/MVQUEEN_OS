{% liquid
  assign is_princess_edit = false
  if section.settings.brand_style == 'princess'
    assign is_princess_edit = true
  elsif section.settings.collection != blank and section.settings.collection.handle contains 'miss-princess'
    assign is_princess_edit = true
  endif
%}
{% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | escape }}"{% endif %}
  class="mvq-section mvq-featured-edit{% if is_princess_edit %} mvq-featured-edit--princess{% endif %}"
>
  <div class="mvq-container">
    <div class="mvq-featured-edit__head">
      <div>
        <div class="mvq-eyebrow">{{ section.settings.eyebrow }}</div>
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.copy != blank %}<p class="mvq-copy">{{ section.settings.copy }}</p>{% endif %}
      </div>
      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <a class="mvq-button mvq-button--quiet" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>
    <div class="mvq-grid">
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product, image_sizes: '(max-width: 480px) calc(50vw - 26px), (max-width: 800px) calc(50vw - 32px), 25vw' %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Featured products",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Section anchor ID"},
    {"type":"select","id":"brand_style","label":"Brand style","options":[{"value":"mvqueen","label":"MVQueen"},{"value":"princess","label":"Miss.Princess"}],"default":"mvqueen"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE MVQueen EDIT"},
    {"type":"text","id":"heading","label":"Heading","default":"Made to be noticed."},
    {"type":"textarea","id":"copy","label":"Intro copy"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Products","min":1,"max":12,"step":1,"default":8},
    {"type":"text","id":"cta_label","label":"CTA label","default":"Shop the edit"},
    {"type":"url","id":"cta_link","label":"CTA link"}
  ],
  "presets": [{"name":"Featured products"}]
}
{% endschema %}
