{% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
<section class="mvq-section">
  <div class="mvq-container">
    <div class="mvq-eyebrow">THE MVQueen EDIT</div>
    <h2>{{ section.settings.heading }}</h2>
    <div class="mvq-grid">
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Featured products",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Made to be noticed."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Products","min":2,"max":12,"step":1,"default":8}
  ]
}
{% endschema %}