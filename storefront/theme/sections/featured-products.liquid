<section class="mvq-section"><div class="mvq-container"><div class="mvq-eyebrow">THE MVQUEEN EDIT</div><h2>{{ section.settings.heading }}</h2>{% if section.settings.collection != blank %}<div class="mvq-grid">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div>{% endif %}</div></section>{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Made to be noticed."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":12,"step":1,"default":8}]}{% endschema %}