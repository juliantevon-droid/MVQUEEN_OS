<section class="mvq-404 mvq-container" aria-labelledby="mvq-404-title">
  <div class="mvq-404-inner">
    <p class="mvq-eyebrow">MVQUEEN</p>
    <h1 id="mvq-404-title">{{ 'general.404.title' | t }}</h1>
    <p class="mvq-404-message">The page you’re looking for has moved, changed, or is no longer available. Let’s get you back to the edit.</p>
    <div class="mvq-404-actions">
      <a class="mvq-button" href="{{ routes.root_url }}">Return home</a>
      <a class="mvq-button mvq-button--secondary" href="{{ routes.search_url }}">Search the edit</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
