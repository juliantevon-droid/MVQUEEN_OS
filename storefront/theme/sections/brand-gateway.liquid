{% liquid
  assign mvqueen_gateway_image = section.settings.mvqueen_image
  if mvqueen_gateway_image == blank and collections['mvqueen-world'] != blank and collections['mvqueen-world'].products.first.featured_image != blank
    assign mvqueen_gateway_image = collections['mvqueen-world'].products.first.featured_image
  endif

  assign princess_gateway_image = section.settings.princess_image
  if princess_gateway_image == blank and collections['miss-princess-world'] != blank and collections['miss-princess-world'].products.first.featured_image != blank
    assign princess_gateway_image = collections['miss-princess-world'].products.first.featured_image
  endif

  assign princess_loading = 'lazy'
  assign princess_fetchpriority = 'low'
  assign mvqueen_logo_sizes = '(max-width: 438px) calc(100vw - 48px), (max-width: 749px) 390px, min(470px, 38vw)'
  assign mvqueen_logo_fetchpriority = 'high'
%}
<section class="mvq-gateway" aria-labelledby="BrandGatewayTitle">
  <div class="mvq-gateway-house">
    <p>ONE HOUSE · TWO DISTINCT WORLDS</p>
    <h1 id="BrandGatewayTitle">Choose your experience.</h1>
  </div>

  <a class="mvq-gateway-panel mvq-gateway-panel--mvqueen" href="/pages/mvqueen">
    {% if mvqueen_gateway_image != blank %}
      {{ mvqueen_gateway_image | image_url: width: 720 | image_tag: class: 'mvq-gateway-media mvq-gateway-media--mvqueen', widths: '320, 360, 412, 480, 540, 640, 720', sizes: '(max-width: 749px) 100vw, 50vw', loading: 'eager', fetchpriority: 'high', decoding: 'async', alt: 'MVQueen' }}
    {% endif %}
    <span class="mvq-gateway-overlay" aria-hidden="true"></span>
    <span class="mvq-gateway-content">
      <span class="mvq-gateway-eyebrow">{{ section.settings.mvqueen_eyebrow }}</span>
      <span class="mvq-gateway-brandmark">
        {% if settings.brand_logo != blank %}
          {{ settings.brand_logo | image_url: width: 956 | image_tag: class: 'mvq-gateway-brandmark-image', widths: '240,320,360,400,480,560,640,800,956', sizes: mvqueen_logo_sizes, loading: 'eager', fetchpriority: mvqueen_logo_fetchpriority, decoding: 'async', alt: '' }}
        {% else %}
          <img
            class="mvq-gateway-brandmark-image"
            src="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=956"
            srcset="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=240 240w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=320 320w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=360 360w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=400 400w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=480 480w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=560 560w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=640 640w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=800 800w, https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639&amp;width=956 956w"
            sizes="{{ mvqueen_logo_sizes }}"
            width="956"
            height="431"
            alt=""
            aria-hidden="true"
            loading="eager"
            fetchpriority="{{ mvqueen_logo_fetchpriority }}"
            decoding="async"
          >
        {% endif %}
        <span class="mvq-visually-hidden">MVQueen</span>
      </span>
      <span class="mvq-gateway-copy">{{ section.settings.mvqueen_copy }}</span>
      <span class="mvq-gateway-cta">{{ section.settings.mvqueen_cta }} <span aria-hidden="true">→</span></span>
    </span>
  </a>

  <a class="mvq-gateway-panel mvq-gateway-panel--princess" href="/pages/miss-princess">
    {% if princess_gateway_image != blank %}
      {{ princess_gateway_image | image_url: width: 480 | image_tag: class: 'mvq-gateway-media mvq-gateway-media--princess', widths: '320, 360, 412, 480', sizes: '(max-width: 749px) 100vw, 50vw', loading: princess_loading, fetchpriority: princess_fetchpriority, decoding: 'async', alt: 'Miss.Princess' }}
    {% endif %}
    <span class="mvq-gateway-overlay" aria-hidden="true"></span>
    <span class="mvq-gateway-content">
      <span class="mvq-gateway-eyebrow">{{ section.settings.princess_eyebrow }}</span>
      <strong class="mvq-gateway-title">Miss.Princess</strong>
      <span class="mvq-gateway-copy">{{ section.settings.princess_copy }}</span>
      <span class="mvq-gateway-cta">{{ section.settings.princess_cta }} <span aria-hidden="true">→</span></span>
    </span>
  </a>
</section>

{% schema %}
{
  "name": "Brand Gateway",
  "settings": [
    {
      "type": "image_picker",
      "id": "mvqueen_image",
      "label": "MVQueen image"
    },
    {
      "type": "text",
      "id": "mvqueen_eyebrow",
      "label": "MVQueen eyebrow",
      "default": "MODERN LUXURY"
    },
    {
      "type": "textarea",
      "id": "mvqueen_copy",
      "label": "MVQueen description",
      "default": "Bold femininity, modern elegance, and everyday luxury."
    },
    {
      "type": "text",
      "id": "mvqueen_cta",
      "label": "MVQueen button text",
      "default": "Enter MVQueen"
    },
    {
      "type": "image_picker",
      "id": "princess_image",
      "label": "Miss.Princess image"
    },
    {
      "type": "text",
      "id": "princess_eyebrow",
      "label": "Miss.Princess eyebrow",
      "default": "PLAYFUL GLAMOUR"
    },
    {
      "type": "textarea",
      "id": "princess_copy",
      "label": "Miss.Princess description",
      "default": "A softer, playful world with its own wardrobe, beauty, jewels, moods, and stories."
    },
    {
      "type": "text",
      "id": "princess_cta",
      "label": "Miss.Princess button text",
      "default": "Enter Miss.Princess"
    }
  ],
  "presets": [
    {
      "name": "Brand Gateway"
    }
  ]
}
{% endschema %}
