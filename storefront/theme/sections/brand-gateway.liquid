{% liquid
  assign mvqueen_gateway_image = section.settings.mvqueen_image
  if mvqueen_gateway_image == blank and collections['mvqueen-world'] != blank and collections['mvqueen-world'].products.first.featured_image != blank
    assign mvqueen_gateway_image = collections['mvqueen-world'].products.first.featured_image
  endif

  assign princess_gateway_image = section.settings.princess_image
  if princess_gateway_image == blank and collections['miss-princess-world'] != blank and collections['miss-princess-world'].products.first.featured_image != blank
    assign princess_gateway_image = collections['miss-princess-world'].products.first.featured_image
  endif
%}
<section class="mvq-gateway" aria-labelledby="BrandGatewayTitle">
  <div class="mvq-gateway-house">
    <p>ONE HOUSE · TWO DISTINCT WORLDS</p>
    <h1 id="BrandGatewayTitle">Choose your experience.</h1>
  </div>

  <a class="mvq-gateway-panel mvq-gateway-panel--mvqueen" href="/pages/mvqueen" aria-label="Enter the MVQueen experience">
    {% if mvqueen_gateway_image != blank %}
      {{ mvqueen_gateway_image | image_url: width: 1800 | image_tag: class: 'mvq-gateway-media mvq-gateway-media--mvqueen', widths: '480, 750, 1100, 1500, 1800', sizes: '(max-width: 749px) 100vw, 50vw', loading: 'eager', fetchpriority: 'high', alt: 'MVQueen' }}
    {% endif %}
    <span class="mvq-gateway-overlay" aria-hidden="true"></span>
    <span class="mvq-gateway-content">
      <span class="mvq-gateway-eyebrow">{{ section.settings.mvqueen_eyebrow }}</span>
      <span class="mvq-gateway-brandmark">
        <img src="https://cdn.shopify.com/s/files/1/0764/2618/2854/files/mvqueen-logo-refined.png?v=1790334639" width="956" height="431" alt="" aria-hidden="true" loading="eager">
        <span class="mvq-visually-hidden">MVQueen</span>
      </span>
      <span class="mvq-gateway-copy">{{ section.settings.mvqueen_copy }}</span>
      <span class="mvq-gateway-cta">{{ section.settings.mvqueen_cta }} <span aria-hidden="true">→</span></span>
    </span>
  </a>

  <a class="mvq-gateway-panel mvq-gateway-panel--princess" href="/pages/miss-princess" aria-label="Enter the Miss.Princess experience">
    {% if princess_gateway_image != blank %}
      {{ princess_gateway_image | image_url: width: 1800 | image_tag: class: 'mvq-gateway-media mvq-gateway-media--princess', widths: '480, 750, 1100, 1500, 1800', sizes: '(max-width: 749px) 100vw, 50vw', loading: 'eager', alt: 'Miss.Princess' }}
    {% endif %}
    <span class="mvq-gateway-overlay" aria-hidden="true"></span>
    <span class="mvq-gateway-content">
      <span class="mvq-gateway-eyebrow">{{ section.settings.princess_eyebrow }}</span>
      <strong class="mvq-gateway-title">Miss.Princess</strong>
      <span class="mvq-gateway-copy">{{ section.settings.princess_copy }}</span>
      <span class="mvq-gateway-cta">{{ section.settings.princess_cta }} <span aria-hidden="true">→</span></span>
    </span>
  </a>
</section>

{% schema %}
{
  "name": "Brand Gateway",
  "settings": [
    {
      "type": "image_picker",
      "id": "mvqueen_image",
      "label": "MVQueen image"
    },
    {
      "type": "text",
      "id": "mvqueen_eyebrow",
      "label": "MVQueen eyebrow",
      "default": "MODERN LUXURY"
    },
    {
      "type": "textarea",
      "id": "mvqueen_copy",
      "label": "MVQueen description",
      "default": "Bold femininity, modern elegance, and everyday luxury."
    },
    {
      "type": "text",
      "id": "mvqueen_cta",
      "label": "MVQueen button text",
      "default": "Enter MVQueen"
    },
    {
      "type": "image_picker",
      "id": "princess_image",
      "label": "Miss.Princess image"
    },
    {
      "type": "text",
      "id": "princess_eyebrow",
      "label": "Miss.Princess eyebrow",
      "default": "PLAYFUL GLAMOUR"
    },
    {
      "type": "textarea",
      "id": "princess_copy",
      "label": "Miss.Princess description",
      "default": "A softer, playful world with its own wardrobe, beauty, jewels, moods, and stories."
    },
    {
      "type": "text",
      "id": "princess_cta",
      "label": "Miss.Princess button text",
      "default": "Enter Miss.Princess"
    }
  ],
  "presets": [
    {
      "name": "Brand Gateway"
    }
  ]
}
{% endschema %}