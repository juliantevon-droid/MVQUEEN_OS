{% render 'mvq-section-kit' %}
{% liquid
  assign tab_product = section.settings.product | default: product
  assign tab_count = 0
  assign tab_buttons = ''
%}
{% capture tab_panels %}
  {% for block in section.blocks %}
    {% liquid
      assign has_content = false
      case block.settings.source
        when 'collection'
          if block.settings.collection != blank and block.settings.collection.products_count > 0
            assign has_content = true
          endif
        when 'description'
          if tab_product.description != blank
            assign has_content = true
          endif
        when 'custom'
          if block.settings.content != blank or block.settings.page.content != blank
            assign has_content = true
          endif
      endcase
    %}
    {% if has_content or request.design_mode %}
      {% assign tab_count = tab_count | plus: 1 %}
      {% capture tab_buttons %}{{ tab_buttons }}<button id="MVQTab-{{ section.id }}-{{ block.id }}" class="mvq-kit__control mvq-kit__tab" type="button" data-tab aria-controls="MVQPanel-{{ section.id }}-{{ block.id }}">{{ block.settings.title | escape }}</button>{% endcapture %}
      <div id="MVQPanel-{{ section.id }}-{{ block.id }}" class="mvq-kit__tab-panel" data-panel aria-labelledby="MVQTab-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
        <h3 class="mvq-kit__tab-heading">{{ block.settings.title | escape }}</h3>
        {% case block.settings.source %}
          {% when 'collection' %}
            <div class="mvq-kit__grid">{% for item in block.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: item %}{% endfor %}</div>
          {% when 'description' %}<div class="mvq-kit__richtext">{{ tab_product.description }}</div>
          {% when 'custom' %}<div class="mvq-kit__richtext">{{ block.settings.content }}{{ block.settings.page.content }}</div>
        {% endcase %}
        {% unless has_content %}<p class="mvq-kit__empty">{{ 'section_kit.empty.tab' | t }}</p>{% endunless %}
      </div>
    {% endif %}
  {% endfor %}
{% endcapture %}
{% if tab_count > 0 %}
<div class="mvq-kit mvq-kit--{{ section.settings.palette }}" style="--kit-space: {{ section.settings.spacing }}px; --kit-columns: {{ section.settings.columns | default: 3 }}; --kit-ratio: {{ section.settings.ratio | default: 1 }};">
  <div class="mvq-kit__wrap">
    {% render 'mvq-section-heading', heading: section.settings.heading, intro: section.settings.intro %}
    <mvq-tabs>
      <div class="mvq-kit__tab-list" data-tab-list hidden aria-label="{{ section.settings.heading | default: section.settings.accessibility_label | escape }}">{{ tab_buttons }}</div>
      {{ tab_panels }}
    </mvq-tabs>
  </div>
</div>
{% endif %}
{% schema %}
{
  "name": "MVQUEEN Product tabs",
  "tag": "section",
  "class": "mvq-editor-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ],
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the edit"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Tab group accessibility label",
      "default": "Product information and collections"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product for description tabs"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products per collection tab",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Palette",
      "options": [
        {
          "value": "neutral",
          "label": "White"
        },
        {
          "value": "mvqueen",
          "label": "MVQUEEN ivory"
        },
        {
          "value": "princess",
          "label": "Miss.Princess blush"
        }
      ],
      "default": "neutral"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Section spacing",
      "min": 24,
      "max": 120,
      "step": 8,
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "MVQUEEN Product tabs",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "Collection"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Tab content",
          "options": [
            {
              "value": "collection",
              "label": "Collection products"
            },
            {
              "value": "description",
              "label": "Product description"
            },
            {
              "value": "custom",
              "label": "Text or page"
            }
          ],
          "default": "collection"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
