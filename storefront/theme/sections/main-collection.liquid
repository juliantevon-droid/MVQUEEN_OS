<section class="mvq-collection"><div class="mvq-container">{% render 'breadcrumbs' %}<div class="mvq-collection-head"><p class="mvq-eyebrow">THE MVQUEEN EDIT</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="mvq-collection-desc">{{ collection.description }}</div>{% endif %}</div><div class="mvq-collection-toolbar"><span>{{ collection.products_count }} pieces</span><button class="mvq-filter-toggle" type="button" data-filter-open aria-controls="CollectionFilters" aria-expanded="false">Filter & refine</button><form method="get" action="{{ collection.url }}"><label class="mvq-visually-hidden" for="CollectionSort">Sort products</label><select id="CollectionSort" class="mvq-sort" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div><div class="mvq-filter-backdrop" data-filter-backdrop></div><div class="mvq-collection-layout"><aside id="CollectionFilters" class="mvq-filters" data-filter-drawer aria-label="Filter products"><button type="button" class="mvq-filter-toggle" data-filter-close>Close filters</button><form method="get" action="{{ collection.url }}">{% for filter in collection.filters %}<details class="mvq-filter-group" {% if filter.active_values.size > 0 %}open{% endif %}><summary>{{ filter.label }}</summary>{% if filter.type == 'price_range' %}<div class="mvq-price-row"><input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="Min" min="0"><input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="Max" min="0"></div>{% else %}<div class="mvq-filter-options">{% for value in filter.values %}<label class="mvq-filter-option"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}><span>{{ value.label }}{% if value.count %} ({{ value.count }}){% endif %}</span></label>{% endfor %}</div>{% endif %}</details>{% endfor %}<div class="mvq-filter-actions"><button type="submit">Apply filters</button><a href="{{ collection.url }}">Clear</a></div></form></aside><div>{% paginate collection.products by 24 %}<div class="mvq-product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No pieces match these filters yet.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="mvq-pagination" aria-label="Pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}<span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}{% endpaginate %}</div></div></div></section>{% schema %}{"name":"MVQUEEN Collection","settings":[],"presets":[{"name":"MVQUEEN Collection"}]}{% endschema %}