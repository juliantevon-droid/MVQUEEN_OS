<section class="mvq-collection"><style>.mvq-collection{padding:48px 0 72px}.mvq-collection-layout{display:grid;grid-template-columns:240px 1fr;gap:32px}.mvq-collection-head{display:grid;gap:12px;margin-bottom:28px}.mvq-collection-desc{max-width:760px;color:var(--mink)}.mvq-collection-toolbar{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:24px;padding:14px 0;border-block:1px solid rgba(26,22,18,.12)}.mvq-filter-toggle{border:1px solid rgba(26,22,18,.25);background:transparent;padding:10px 14px;cursor:pointer}.mvq-filters{position:sticky;top:90px;height:max-content}.mvq-filter-group{padding:0 0 22px;margin:0 0 22px;border-bottom:1px solid rgba(26,22,18,.1)}.mvq-filter-group summary{cursor:pointer;font-weight:600;list-style:none}.mvq-filter-options{display:grid;gap:9px;margin-top:14px}.mvq-filter-option{display:flex;align-items:center;gap:8px;font-size:.9rem}.mvq-price-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}.mvq-price-row input{width:100%;padding:10px;border:1px solid rgba(26,22,18,.2);background:var(--white)}.mvq-filter-actions{display:flex;gap:8px;margin-top:16px}.mvq-filter-actions button,.mvq-filter-actions a{padding:10px 14px;border:1px solid var(--ink)}.mvq-filter-actions button{background:var(--ink);color:var(--white);cursor:pointer}.mvq-sort{padding:10px 12px;border:1px solid rgba(26,22,18,.2);background:var(--white)}.mvq-product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 18px}.mvq-pagination{display:flex;justify-content:center;gap:16px;margin-top:48px}.mvq-active-filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}.mvq-active-filter{font-size:.8rem;padding:7px 10px;background:var(--petal)}.mvq-filter-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:90}@media(max-width:800px){.mvq-collection-layout{display:block}.mvq-filters{position:fixed;inset:0 0 0 auto;width:min(88vw,360px);background:var(--white);z-index:100;transform:translateX(105%);transition:transform .25s ease;padding:24px;overflow:auto;box-shadow:-10px 0 30px rgba(0,0,0,.12)}.mvq-filters.is-open{transform:translateX(0)}.mvq-filter-backdrop.is-open{display:block}.mvq-product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 10px}}@media(max-width:480px){.mvq-product-grid{grid-template-columns:1fr}}</style><div class="mvq-container">{% render 'breadcrumbs' %}<div class="mvq-collection-head"><p class="mvq-eyebrow">THE MVQUEEN EDIT</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="mvq-collection-desc">{{ collection.description }}</div>{% endif %}</div><div class="mvq-collection-toolbar"><span>{{ collection.products_count }} pieces</span><button class="mvq-filter-toggle" type="button" data-filter-open aria-controls="CollectionFilters" aria-expanded="false">Filter & refine</button><form method="get" action="{{ collection.url }}"><label class="mvq-visually-hidden" for="CollectionSort">Sort products</label><select id="CollectionSort" class="mvq-sort" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div><div class="mvq-filter-backdrop" data-filter-backdrop aria-hidden="true"></div><div class="mvq-collection-layout"><aside id="CollectionFilters" class="mvq-filters" data-filter-drawer aria-label="Filter products"><button type="button" class="mvq-filter-toggle" data-filter-close>Close filters</button><form method="get" action="{{ collection.url }}">{% for filter in collection.filters %}<details class="mvq-filter-group" {% if filter.active_values.size > 0 %}open{% endif %}><summary>{{ filter.label }}</summary>{% if filter.type == 'price_range' %}<div class="mvq-price-row"><input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="Min" min="0"><input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="Max" min="0"></div>{% else %}<div class="mvq-filter-options">{% for value in filter.values %}<label class="mvq-filter-option"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}><span>{{ value.label }}{% if value.count %} ({{ value.count }}){% endif %}</span></label>{% endfor %}</div>{% endif %}</details>{% endfor %}<div class="mvq-filter-actions"><button type="submit">Apply filters</button><a href="{{ collection.url }}">Clear</a></div></form></aside><div>{% if collection.filters.size > 0 %}<div class="mvq-active-filters">{% for filter in collection.filters %}{% for value in filter.active_values %}<a class="mvq-active-filter" href="{{ value.url_to_remove }}">{{ filter.label }}: {{ value.label }} ×</a>{% endfor %}{% endfor %}</div>{% endif %}{% paginate collection.products by 24 %}<div class="mvq-product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No pieces match these filters yet.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="mvq-pagination" aria-label="Pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}<span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}{% endpaginate %}</div></div></div></section>{% schema %}{"name":"MVQUEEN Collection","settings":[],"presets":[{"name":"MVQUEEN Collection"}]}{% endschema %}