{% liquid
  assign hero_image = section.settings.image
%}
<section class="mvq-hero">
  <div class="mvq-hero-copy mvq-container">
    <div class="mvq-eyebrow">MVQueen / WOMEN'S STYLE</div>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    <a class="mvq-btn" href="{{ section.settings.button_link | default: '/collections/mvqueen-world' }}">{{ section.settings.button_label }}</a>
  </div>
  <div class="mvq-hero-art{% if hero_image != blank %} mvq-hero-art--media{% endif %}">
    {% if hero_image != blank %}
      {{ hero_image | image_url: width: 1600 | image_tag: class: 'mvq-hero-image', widths: '480,750,1100,1400,1600', sizes: '(max-width: 800px) 100vw, 46vw', loading: 'eager', alt: 'MVQueen curated product' }}
      <span class="mvq-hero-image-wash" aria-hidden="true"></span>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name":"MVQueen Hero",
  "settings":[
    {"type":"image_picker","id":"image","label":"Hero image"},
    {"type":"text","id":"heading","label":"Heading","default":"Luxury that feels like you."},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Bold femininity, modern elegance, and everyday luxury — thoughtfully curated for the woman you are becoming."},
    {"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},
    {"type":"url","id":"button_link","label":"Button link"}
  ]
}
{% endschema %}
