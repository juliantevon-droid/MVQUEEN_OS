{% if product %}{% liquid assign variant = product.selected_or_first_available_variant assign product_brand = product.vendor | default: 'MVQueen' %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":{{ product.title | json }},"url":{{ canonical_url | json }},"description":{{ product.description | strip_html | strip_newlines | json }},"brand":{"@type":"Brand","name":{{ product_brand | json }}},"image":[{% for media in product.media %}{% if media.preview_image %}{{ media.preview_image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}],"offers":{"@type":"Offer","url":{{ canonical_url | json }},"priceCurrency":{{ cart.currency.iso_code | json }},"price":{{ variant.price | divided_by: 100.0 | json }},"availability":"https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}"{% if variant.sku != blank %},"sku":{{ variant.sku | json }}{% endif %}{% if variant.barcode != blank %},"gtin":{{ variant.barcode | json }}{% endif %}}}</script>{% endif %}