{% if product %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":{{ product.title | json }},"url":{{ canonical_url | json }},"description":{{ product.description | strip_html | strip_newlines | json }},"brand":{"@type":"Brand","name":"MVQUEEN"},"image":[{% for media in product.media %}{% if media.preview_image %}{{ media.preview_image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}],"offers":{"@type":"Offer","url":{{ canonical_url | json }},"priceCurrency":{{ cart.currency.iso_code | json }},"price":{{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},"availability":"https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}"}{% if product.selected_or_first_available_variant.sku != blank %},"sku":{{ product.selected_or_first_available_variant.sku | json }}{% endif %}{% if product.selected_or_first_available_variant.barcode != blank %},"gtin":{{ product.selected_or_first_available_variant.barcode | json }}{% endif %}}</script>{% endif %}