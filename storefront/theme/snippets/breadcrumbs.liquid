<nav class="mvq-breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>{% if request.page_type == 'product' %}{% assign crumb_collection = product.collections | first %}{% if crumb_collection %}<a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a><span aria-hidden="true">/</span>{% endif %}<span aria-current="page">{{ product.title }}</span>{% elsif request.page_type == 'collection' %}<span aria-current="page">{{ collection.title }}</span>{% endif %}</nav>