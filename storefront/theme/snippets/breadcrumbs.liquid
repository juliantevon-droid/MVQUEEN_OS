<nav class="mvq-breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>{% if request.page_type == 'product' %}{% assign crumb_collection = product.collections | first %}{% if crumb_collection %}<a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a><span aria-hidden="true">/</span>{% endif %}<span aria-current="page">{{ product.title }}</span>{% elsif request.page_type == 'collection' %}<span aria-current="page">{{ collection.title }}</span>{% endif %}</nav><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | append: routes.root_url | json }}}{% if request.page_type == 'product' %}{% assign crumb_collection = product.collections | first %}{% if crumb_collection %},{"@type":"ListItem","position":2,"name":{{ crumb_collection.title | json }},"item":{{ shop.url | append: crumb_collection.url | json }}},{"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ canonical_url | json }}{% else %},{"@type":"ListItem","position":2,"name":{{ product.title | json }},"item":{{ canonical_url | json }}{% endif %}{% elsif request.page_type == 'collection' %},{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ canonical_url | json }}{% endif %}]}</script><style>.mvq-breadcrumbs{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:.78rem;color:var(--mink);margin-bottom:22px}.mvq-breadcrumbs a{color:inherit}.mvq-breadcrumbs a:hover{text-decoration:underline}</style>