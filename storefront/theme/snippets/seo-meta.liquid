{%- liquid
  assign meta_title = page_title | default: shop.name
  assign normalized_meta_title = meta_title | downcase
  assign normalized_shop_name = shop.name | downcase
  assign meta_description = page_description | default: shop.description | default: 'Discover the MVQueen edit of fashion, beauty, jewelry, and everyday luxury.'
  if request.page_type == 'index'
    assign meta_title = 'MVQUEEN | Fashion, Beauty, Jewelry and Everyday Luxury'
    assign meta_description = 'Discover MVQUEEN—fashion, beauty, jewelry, and everyday luxury for the woman who chooses with intention. Curated to restore softness, confidence, and ease.'
    assign normalized_meta_title = meta_title | downcase
  endif
  assign meta_image = page_image | default: settings.share_image
  assign noindex_page = false
  if request.page_type == 'search' or request.page_type == 'cart'
    assign noindex_page = true
  elsif request.page_type == 'collection' and collection.products_count == 0
    assign noindex_page = true
  endif
-%}
<title>{{ meta_title | escape }}{% unless normalized_meta_title contains normalized_shop_name %} — {{ shop.name | escape }}{% endunless %}</title>
<meta name="description" content="{{ meta_description | strip_html | strip_newlines | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
{% if noindex_page %}
  <meta name="robots" content="noindex,follow">
{% else %}
  <meta name="robots" content="index,follow">
{% endif %}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:title" content="{{ meta_title | escape }}">
<meta property="og:description" content="{{ meta_description | strip_html | strip_newlines | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
{% if meta_image %}<meta property="og:image" content="{{ meta_image | image_url: width: 1600 | prepend: 'https:' }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ meta_title | escape }}">
<meta name="twitter:description" content="{{ meta_description | strip_html | strip_newlines | escape }}">
{% if meta_image %}<meta name="twitter:image" content="{{ meta_image | image_url: width: 1600 | prepend: 'https:' }}">{% endif %}
{% if request.page_type == 'index' %}
  {% capture search_target %}{{ shop.url }}{{ routes.search_url }}?q={search_term_string}{% endcapture %}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":{{ shop.name | json }},"url":{{ shop.url | json }},"potentialAction":{"@type":"SearchAction","target":{{ search_target | strip | json }},"query-input":"required name=search_term_string"}}</script>
{% endif %}
