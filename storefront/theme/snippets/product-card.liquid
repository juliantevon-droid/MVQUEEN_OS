<a class="mvq-card" href="{{ product.url }}">{% if product.featured_image %}<div class="mvq-card-media">{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title | escape }}</div>{% endif %}<div class="mvq-card-info"><h3 class="mvq-card-title">{{ product.title }}</h3><div class="mvq-card-price">{{ product.price | money }}</div></div></a>