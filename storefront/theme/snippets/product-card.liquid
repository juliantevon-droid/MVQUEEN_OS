{% doc %}
  Renders a product card with responsive imagery and the selected variant price.
  @param {product} product - Product to display
  @example
  {% render 'product-card', product: product %}
{% enddoc %}
{% liquid
  assign card_image = product.featured_image
  assign card_image_alt = card_image.alt | default: product.title
  assign second_image = product.images[1]
  assign card_image_sizes = image_sizes | default: '(max-width: 480px) calc(50vw - 20px), (max-width: 800px) calc(50vw - 24px), 33vw'
  assign first_variant = product.selected_or_first_available_variant
  assign has_sale = false
  assign is_jewelry = false
  if product.tags contains 'mvq:category:jewelry'
    assign is_jewelry = true
  endif
  if first_variant.available and first_variant.compare_at_price > first_variant.price
    assign has_sale = true
  endif
%}
<article class="mvq-card{% if is_jewelry %} mvq-card--jewelry{% endif %}">
  <a class="mvq-card-link" href="{{ product.url }}">
    <div class="mvq-card-media">
      {% if card_image %}
        {{ card_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '180,240,320,360,480', sizes: card_image_sizes, alt: card_image_alt }}
        {% if second_image %}
          <span class="mvq-card-media-alt" aria-hidden="true">
            {{ second_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '180,240,320,360,480', sizes: card_image_sizes, alt: '' }}
          </span>
        {% endif %}
      {% else %}
        <div class="mvq-card-media-placeholder" aria-hidden="true"></div>
      {% endif %}
      {% unless product.available %}<span class="mvq-badge">{{ 'section_kit.controls.sold_out' | t }}</span>{% endunless %}
      {% if has_sale %}<span class="mvq-badge">{{ 'section_kit.controls.sale' | t }}</span>{% endif %}
    </div>
    <div class="mvq-card-info">
      {% if product.type != blank %}<p class="mvq-card-type">{{ product.type }}</p>{% endif %}
      <h3 class="mvq-card-title">{{ product.title }}</h3>
      <div class="mvq-card-price">
        {% if has_sale %}
          <span class="mvq-price-current">{{ first_variant.price | money }}</span>
          <s>{{ first_variant.compare_at_price | money }}</s>
        {% else %}
          {{ first_variant.price | money }}
        {% endif %}
      </div>
    </div>
  </a>
</article>
