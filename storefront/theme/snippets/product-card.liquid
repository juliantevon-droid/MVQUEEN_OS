{% liquid assign card_image = product.featured_image assign first_variant = product.selected_or_first_available_variant assign product_label = product.title | escape %}<a class="mvq-card" href="{{ product.url }}" aria-label="View {{ product_label }}"><div class="mvq-card-media">{% if card_image %}{{ card_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320,480,640,800', sizes: '(max-width: 480px) 50vw, (max-width: 800px) 50vw, 33vw', alt: card_image.alt | default: product.title | escape }}{% else %}<div class="mvq-card-media-placeholder" aria-hidden="true"></div>{% endif %}{% unless product.available %}<span class="mvq-badge">Sold out</span>{% endunless %}{% if product.available and product.compare_at_price_max > product.price %}<span class="mvq-badge">Sale</span>{% endif %}</div><div class="mvq-card-info">{% if product.type != blank %}<p class="mvq-card-type">{{ product.type }}</p>{% endif %}<h3 class="mvq-card-title">{{ product.title }}</h3><div class="mvq-card-price">{% if product.compare_at_price_max > product.price %}<span>{{ first_variant.price | money }}</span> <s>{{ first_variant.compare_at_price | money }}</s>{% else %}{{ first_variant.price | money }}{% endif %}</div></div></a>