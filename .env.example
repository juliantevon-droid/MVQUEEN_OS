# MVQUEEN_OS canonical environment template
# Real secrets stay in the deployment environment and are never committed.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,write_metaobjects
DATABASE_URL=
NODE_ENV=development

# Canonical Shopify API version
SHOPIFY_API_VERSION=2026-07

# Catalog automation is fail-closed by default. The live app does not generate product copy.
MVQ_WRITE_ENABLED=false

# Explicit comma-separated Shopify product GIDs approved for automated writes.
# Example format only: gid://shopify/Product/123,gid://shopify/Product/456
MVQ_APPROVED_PRODUCT_GIDS=
