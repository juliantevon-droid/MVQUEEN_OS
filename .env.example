# MVQUEEN_OS canonical environment template
# Real secrets stay in the deployment environment and are never committed.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_inventory,read_content,write_content,read_files,write_files,write_metaobjects
DATABASE_URL=file:./dev.sqlite
MVQ_DATABASE_PROFILE=development
NODE_ENV=development

# Canonical Shopify API version
SHOPIFY_API_VERSION=2026-07

# Global Shopify write kill switch. Keep false outside a deployed, authenticated environment.
MVQ_WRITE_ENABLED=false

# When true, every products/create and products/update webhook is automatically
# eligible for the protected-field-safe catalog writer. When false, the legacy
# MVQ_APPROVED_PRODUCT_GIDS allowlist remains available for manual product approval.
MVQ_AUTO_PRODUCT_ENROLLMENT_ENABLED=false

# When true, classified products also receive automatic MVQueen editorial/SEO
# fields: sanitized title, short description, highlights, focus keyword,
# long-tail keywords, combined SEO keywords and Shopify SEO title/meta.
MVQ_EDITORIAL_PUBLISH_ENABLED=false

# Fill only missing product image ALT text. Requires read_files/write_files and app reauthorization.
MVQ_MEDIA_ALT_SYNC_ENABLED=false

# Approved content surfaces. These are per-surface kill switches; the canonical
# QA/fingerprint/editorial publish boundary still controls the release.
MVQ_BLOG_PUBLISH_ENABLED=true
MVQ_BLOG_HANDLE=news
MVQ_BLOG_CREATE_IF_MISSING=true
MVQ_BLOG_TITLE=MVQueen Journal
MVQ_BLOG_AUTHOR=MVQueen
MVQ_COLLECTION_CONTENT_PUBLISH_ENABLED=true
MVQ_FAQ_PAGE_PUBLISH_ENABLED=true
MVQ_FAQ_PAGE_HANDLE=faq
MVQ_STATIC_PAGE_PUBLISH_ENABLED=true

# Separate gate for publishing a human-approved price after contribution-floor validation.
MVQ_PRICE_PUBLISH_ENABLED=false

# Explicit comma-separated Shopify product GIDs approved for automated writes.
# Example format only: gid://shopify/Product/123,gid://shopify/Product/456
MVQ_APPROVED_PRODUCT_GIDS=

# Enterprise commercial intelligence. Leave unset to keep pricing recommendations blocked.
MVQ_PAYMENT_RATE=
MVQ_PAYMENT_FIXED=
MVQ_RETURN_RESERVE_RATE=
MVQ_TARGET_CONTRIBUTION_MARGIN_RATE=
MVQ_TARGET_CAC=
MVQ_INBOUND_SHIPPING_DEFAULT=
MVQ_CURRENCY=USD

# External adapters are disabled unless both a provider name and the matching execution flag are configured.
MVQ_AD_PROVIDER=
MVQ_AD_EXECUTION_ENABLED=false
MVQ_ANALYTICS_PROVIDER=
MVQ_ANALYTICS_EXPORT_ENABLED=false
MVQ_LIFECYCLE_PROVIDER=
MVQ_LIFECYCLE_EXECUTION_ENABLED=false

# Production database example (do not commit real credentials):
# MVQ_DATABASE_PROFILE=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Pull verified unit cost from Shopify inventoryItem.unitCost only after read_inventory is granted.
MVQ_COST_SYNC_ENABLED=false

# Durable catalog reprocessing. Dry-run is always the default.
# Governed catalog-wide Shopify writes additionally require both MVQ_WRITE_ENABLED=true
# and MVQ_BACKFILL_WRITE_ENABLED=true.
MVQ_BACKFILL_WRITE_ENABLED=false

# Required only for unattended calls to POST /internal/catalog-worker.
# Use a deployment secret with at least 32 characters. Never commit a real token.
MVQ_BACKFILL_WORKER_TOKEN=
MVQ_BACKFILL_BATCH_SIZE=10
